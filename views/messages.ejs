// Other conversation functions (similar structure)
function getDavidConversation() {
    return `<div class="date-separator"><span>2 days ago</span></div>
            <div class="message received"><div class="message-avatar">DP</div><div class="message-content"><div class="message-text">Great catch! I'll update the requirements document with your suggestions.</div><div class="message-time">4:20 PM</div></div></div>`;
}

