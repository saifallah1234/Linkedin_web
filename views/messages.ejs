// Message sending
function initializeMessageInput() {
    const messageInput = document.getElementById('messageInput');
    const sendButton = document.getElementById('sendMessageBtn');
    
    messageInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });
}

function sendMessage() {
    const messageInput = document.getElementById('messageInput');
    const message = messageInput.value.trim();
    
    if (!message || !currentContactId) return;
    
    const contact = connectionsData.find(c => c.id === currentContactId);
    if (!contact) return;
    
    // Create sent message
    const messagesArea = document.getElementById('messagesArea');
    const now = new Date();
    const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    
    const messageElement = document.createElement('div');
    messageElement.className = 'message sent';
    messageElement.innerHTML = `
        <div class="message-content">
            <div class="message-text">${message}</div>
            <div class="message-time">${timeString}</div>
        </div>
    `;
    
    messagesArea.appendChild(messageElement);
    messageInput.value = '';
    
    // Scroll to bottom
    messagesArea.scrollTop = messagesArea.scrollHeight;
    
    // Update conversation preview
    updateConversationPreview(message);
    
    // Simulate reply after 1-3 seconds
    setTimeout(() => {
        simulateReply(contact);
    }, 1000 + Math.random() * 2000);
}

function simulateReply(contact) {
    const replies = [
        "Thanks for your message!",
        "That's a great point.",
        "I'll look into that.",
        "Can we discuss this further?",
        "Thanks for getting back to me.",
        "Sounds good to me!",
        "Let me check and get back to you.",
        "I appreciate your feedback."
    ];
    
    const randomReply = replies[Math.floor(Math.random() * replies.length)];
    const messagesArea = document.getElementById('messagesArea');
    const now = new Date();
    const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    
    const replyElement = document.createElement('div');
    replyElement.className = 'message received';
    replyElement.innerHTML = `
        <div class="message-avatar">${contact.avatar}</div>
        <div class="message-content">
            <div class="message-text">${randomReply}</div>
            <div class="message-time">${timeString}</div>
        </div>
    `;
    
    messagesArea.appendChild(replyElement);
    messagesArea.scrollTop = messagesArea.scrollHeight;
    
    // Update conversation preview
    updateConversationPreview(randomReply);
}

function updateConversationPreview(message) {
    const conversation = document.querySelector(`[onclick="selectConversation('${currentContactId}')"]`);
    if (conversation) {
        const preview = conversation.querySelector('.conversation-preview');
        const time = conversation.querySelector('.conversation-time');
        
        if (preview) preview.textContent = message.length > 40 ? message.substring(0, 40) + '...' : message;
        if (time) time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
}

// Options menu
function toggleOptionsMenu() {
    const optionsMenu = document.getElementById('optionsMenu');
    if (optionsMenu.style.display === 'none' || !optionsMenu.style.display) {
        optionsMenu.style.display = 'block';
    } else {
        optionsMenu.style.display = 'none';
    }
}

function closeOptionsMenu() {
    document.getElementById('optionsMenu').style.display = 'none';
}

// Option actions
function viewProfile(contactId) {
    const contact = connectionsData.find(c => c.id === contactId);
    if (contact) {
        showToast(`Viewing ${contact.name}'s profile`);
        closeOptionsMenu();
        // In a real app, this would navigate to the profile page
    }
}

function clearChat() {
    if (confirm('Are you sure you want to clear this chat? This will only clear your view, not the other person\'s.')) {
        const messagesArea = document.getElementById('messagesArea');
        messagesArea.innerHTML = `
            <div class="date-separator">
                <span>Today</span>
            </div>
            <div class="text-center py-5 text-secondary">
                <p>Chat cleared</p>
            </div>
        `;
        showToast('Chat cleared');
        closeOptionsMenu();
    }
}

function muteNotifications() {
    showToast('Notifications muted for this conversation');
    closeOptionsMenu();
}

function blockContact() {
    if (confirm('Are you sure you want to block this contact? You will no longer receive messages from them.')) {
        showToast('Contact blocked');
        closeOptionsMenu();
    }
}

function deleteChat() {
    if (confirm('Are you sure you want to delete this chat? This action cannot be undone.')) {
        showToast('Chat deleted');
        closeOptionsMenu();
        
        // Remove conversation from list
        const conversation = document.querySelector(`[onclick="selectConversation('${currentContactId}')"]`);
        if (conversation) {
            conversation.remove();
        }
        
        // Clear chat area
        const messagesArea = document.getElementById('messagesArea');
        messagesArea.innerHTML = `
            <div class="text-center py-5 text-secondary">
                <p>Select a conversation to start messaging</p>
            </div>
        `;
    }
}

// Utility functions
function attachFile() {
    showToast('File attachment');
    // In a real app, this would open a file picker
}

function showEmojiPicker() {
    showToast('Emoji picker');
    // In a real app, this would show an emoji picker
}

// Toast notification
function showToast(message) {
    const toast = document.createElement('div');
    toast.className = 'custom-toast';
    toast.textContent = message;
    
    document.body.appendChild(toast);
    
    setTimeout(() => {
        toast.style.animation = 'slideDown 0.3s ease-out';
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}
</script>