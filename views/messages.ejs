<%- include('partials/header', { currentPage: 'messages', title: 'Messages - Nexus' }) %>

<div class="container py-4">
    <div class="messages-page">
        <div class="row g-4">
            <!-- Conversations List -->
            <div class="col-lg-4">
                <div class="conversations-container card-nexus">
                    <!-- Header -->
                    <div class="conversations-header p-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="fw-bold mb-0">Messages</h4>
                            <button class="new-message-btn" onclick="openNewMessageModal()">
                                <i class="bi bi-plus-lg"></i> New message
                            </button>
                        </div>
                    </div>
                    
                    <!-- Search -->
                    <div class="conversations-search p-3 border-bottom">
                        <div class="search-wrapper">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" class="search-input" placeholder="Search messages...">
                        </div>
                    </div>
                    
                    <!-- Conversations List -->
                    <div class="conversations-list">
                        <!-- Conversation 1 - Active -->
                        <div class="conversation-item active" onclick="selectConversation('sarah')">
                            <div class="conversation-avatar">SC</div>
                            <div class="conversation-content">
                                <div class="conversation-header">
                                    <h6 class="conversation-name fw-bold">Sarah Chen</h6>
                                    <span class="conversation-time">10:42 AM</span>
                                </div>
                                <p class="conversation-preview">
                                    Thanks for the feedback! Let's schedule a call to discuss the details.
                                </p>
                                <div class="conversation-meta">
                                    <span class="unread-badge">3</span>
                                    <i class="bi bi-check2-all text-primary"></i>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Conversation 2 -->
                        <div class="conversation-item" onclick="selectConversation('marcus')">
                            <div class="conversation-avatar">MW</div>
                            <div class="conversation-content">
                                <div class="conversation-header">
                                    <h6 class="conversation-name fw-bold">Marcus Williams</h6>
                                    <span class="conversation-time">Yesterday</span>
                                </div>
                                <p class="conversation-preview">
                                    The meeting notes are ready. Can you review them before...
                                </p>
                                <div class="conversation-meta">
                                    <i class="bi bi-check2-all"></i>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Conversation 3 -->
                        <div class="conversation-item" onclick="selectConversation('david')">
                            <div class="conversation-avatar">DP</div>
                            <div class="conversation-content">
                                <div class="conversation-header">
                                    <h6 class="conversation-name fw-bold">David Park</h6>
                                    <span class="conversation-time">2 days ago</span>
                                </div>
                                <p class="conversation-preview">
                                    Great catch! I'll update the requirements document...
                                </p>
                                <div class="conversation-meta">
                                    <i class="bi bi-check2 text-secondary"></i>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Conversation 4 -->
                        <div class="conversation-item" onclick="selectConversation('lisa')">
                            <div class="conversation-avatar">LT</div>
                            <div class="conversation-content">
                                <div class="conversation-header">
                                    <h6 class="conversation-name fw-bold">Lisa Thompson</h6>
                                    <span class="conversation-time">1 week ago</span>
                                </div>
                                <p class="conversation-preview">
                                    The design system updates look amazing! Can't wait to...
                                </p>
                                <div class="conversation-meta">
                                    <i class="bi bi-check2-all"></i>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Conversation 5 -->
                        <div class="conversation-item" onclick="selectConversation('james')">
                            <div class="conversation-avatar">JW</div>
                            <div class="conversation-content">
                                <div class="conversation-header">
                                    <h6 class="conversation-name fw-bold">James Wilson</h6>
                                    <span class="conversation-time">2 weeks ago</span>
                                </div>
                                <p class="conversation-preview">
                                    Thanks for the referral! The interview went really well...
                                </p>
                                <div class="conversation-meta">
                                    <i class="bi bi-check2-all"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Chat Area -->
            <div class="col-lg-8">
                <div class="chat-container card-nexus">
                    <!-- Chat Header -->
                    <div class="chat-header p-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="chat-avatar">SC</div>
                                <div>
                                    <h5 class="fw-bold mb-1">Sarah Chen</h5>
                                    <p class="text-secondary small mb-0">
                                        <span class="status-dot online"></span> Active now
                                    </p>
                                </div>
                            </div>
                            <div class="chat-actions">
                                <button class="chat-action-btn" title="View Profile" onclick="viewProfile('sarah')">
                                    <i class="bi bi-person-circle"></i>
                                </button>
                                <button class="chat-action-btn" title="More options" onclick="toggleOptionsMenu()">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Messages Area -->
                    <div class="messages-area" id="messagesArea">
                        <!-- Date separator -->
                        <div class="date-separator">
                            <span>Today</span>
                        </div>
                        
                        <!-- Received message -->
                        <div class="message received">
                            <div class="message-avatar">SC</div>
                            <div class="message-content">
                                <div class="message-text">
                                    Hey Alex! Thanks for reviewing my presentation draft. What do you think?
                                </div>
                                <div class="message-time">10:30 AM</div>
                            </div>
                        </div>
                        
                        <!-- Sent message -->
                        <div class="message sent">
                            <div class="message-content">
                                <div class="message-text">
                                    It looks great! The data visualization is really clear. Just one suggestion on slide 8.
                                </div>
                                <div class="message-time">10:35 AM</div>
                            </div>
                        </div>
                        
                        <!-- Received message -->
                        <div class="message received">
                            <div class="message-avatar">SC</div>
                            <div class="message-content">
                                <div class="message-text">
                                    Oh, which part? I want to make sure it's perfect for tomorrow's meeting.
                                </div>
                                <div class="message-time">10:38 AM</div>
                            </div>
                        </div>
                        
                        <!-- Sent message -->
                        <div class="message sent">
                            <div class="message-content">
                                <div class="message-text">
                                    The comparison chart could use more contrast between the segments. Maybe use different shades of orange?
                                </div>
                                <div class="message-time">10:40 AM</div>
                            </div>
                        </div>
                        
                        <!-- Received message -->
                        <div class="message received">
                            <div class="message-avatar">SC</div>
                            <div class="message-content">
                                <div class="message-text">
                                    Good point! I'll update that now. Thanks for the feedback! Let's schedule a call to discuss the details.
                                </div>
                                <div class="message-time">10:42 AM</div>
                            </div>
                        </div>
                        
                        <!-- Sent message -->
                        <div class="message sent">
                            <div class="message-content">
                                <div class="message-text">
                                    How about 3 PM today? I have a 30-minute slot open.
                                </div>
                                <div class="message-time">10:45 AM</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Message Input -->
                    <div class="message-input p-3 border-top">
                        <div class="input-container">
                            <button class="input-action-btn" title="Add attachment" onclick="showToast('Add attachment')">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            <input type="text" class="message-input-field" placeholder="Type a message..." id="messageInput">
                            <div class="input-actions">
                                <button class="input-action-btn" title="Attach file" onclick="attachFile()">
                                    <i class="bi bi-paperclip"></i>
                                </button>
                                <button class="input-action-btn" title="Emoji" onclick="showEmojiPicker()">
                                    <i class="bi bi-emoji-smile"></i>
                                </button>
                                <button class="send-btn" id="sendMessageBtn" onclick="sendMessage()">
                                    <i class="bi bi-send-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Message Modal -->
<div class="edit-form-overlay" id="newMessageModal">
    <div class="edit-form-container" style="max-width: 600px;">
        <div class="edit-form-header">
            <h3 class="edit-form-title">New Message</h3>
            <button class="close-form-btn" onclick="closeNewMessageModal()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="p-3">
            <!-- Search -->
            <div class="search-recipient mb-4">
                <div class="search-wrapper">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="search-input" placeholder="Search connections..." id="recipientSearch" oninput="searchConnections()">
                </div>
            </div>
            
            <!-- Connections List -->
            <div class="connections-list" id="connectionsList" style="max-height: 400px; overflow-y: auto;">
                <!-- Connections will be loaded here -->
            </div>
            
            <!-- No results -->
            <div class="no-results text-center py-4" id="noResults" style="display: none;">
                <i class="bi bi-people fs-1 text-secondary mb-3"></i>
                <p class="text-secondary">No connections found</p>
            </div>
        </div>
    </div>
</div>

<!-- Options Menu -->
<div class="edit-form-overlay" id="optionsMenu" style="display: none; background: transparent;">
    <div class="options-menu-container" style="position: absolute; top: 80px; right: 20px; background: white; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); min-width: 200px;">
        <div class="options-list p-2">
            <button class="option-item" onclick="viewProfile(currentContactId)">
                <i class="bi bi-person-circle me-2"></i>
                View Profile
            </button>
            <button class="option-item" onclick="clearChat()">
                <i class="bi bi-trash me-2"></i>
                Clear Chat
            </button>
            <button class="option-item" onclick="muteNotifications()">
                <i class="bi bi-bell-slash me-2"></i>
                Mute Notifications
            </button>
            <button class="option-item" onclick="blockContact()">
                <i class="bi bi-slash-circle me-2"></i>
                Block Contact
            </button>
            <hr class="my-2">
            <button class="option-item text-danger" onclick="deleteChat()">
                <i class="bi bi-trash3 me-2"></i>
                Delete Chat
            </button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<style>
/* Options Menu */
.option-item {
    width: 100%;
    padding: 10px 12px;
    background: transparent;
    border: none;
    text-align: left;
    color: var(--text-dark);
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
}

.option-item:hover {
    background: var(--primary-light);
    color: var(--primary-color);
}

.option-item.text-danger:hover {
    background: rgba(239, 68, 68, 0.1);
    color: var(--danger);
}

/* Connection Item */
.connection-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}

.connection-item:hover {
    background: var(--primary-light);
    border-color: var(--border-color);
}

.connection-avatar-small {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #ff7a18 0%, #ff8a3d 100%);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.9rem;
    flex-shrink: 0;
}

/* Toast */
.custom-toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: var(--text-dark);
    color: white;
    padding: 12px 20px;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    z-index: 9999;
    font-size: 0.9rem;
    font-weight: 500;
    animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
    from {
        transform: translateY(100%);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

@keyframes slideDown {
    from {
        transform: translateY(0);
        opacity: 1;
    }
    to {
        transform: translateY(100%);
        opacity: 0;
    }
}
</style>

<script>
let currentContactId = 'sarah';
const connectionsData = [
    { id: 'sarah', name: 'Sarah Chen', title: 'Engineering Lead @ StartupXYZ', avatar: 'SC', online: true },
    { id: 'marcus', name: 'Marcus Williams', title: 'VP of Marketing at GlobalTech', avatar: 'MW', online: true },
    { id: 'david', name: 'David Park', title: 'Product Manager at Meta', avatar: 'DP', online: false },
    { id: 'lisa', name: 'Lisa Thompson', title: 'Design Director at Apple', avatar: 'LT', online: true },
    { id: 'james', name: 'James Wilson', title: 'Senior Developer at Google', avatar: 'JW', online: false },
    { id: 'emily', name: 'Emily Rodriguez', title: 'UX Researcher at Amazon', avatar: 'ER', online: true },
    { id: 'michael', name: 'Michael Brown', title: 'CTO at StartupABC', avatar: 'MB', online: false },
    { id: 'jessica', name: 'Jessica Lee', title: 'Product Designer at Netflix', avatar: 'JL', online: true },
    { id: 'robert', name: 'Robert Taylor', title: 'Software Engineer at Microsoft', avatar: 'RT', online: true },
    { id: 'amanda', name: 'Amanda Clark', title: 'HR Director at TechCorp', avatar: 'AC', online: false }
];

// Initialize
document.addEventListener('DOMContentLoaded', function() {
    loadConnections();
    initializeMessageInput();
    
    // Close options menu when clicking outside
    document.addEventListener('click', function(e) {
        const optionsMenu = document.getElementById('optionsMenu');
        const optionsBtn = document.querySelector('.chat-action-btn[title="More options"]');
        
        if (optionsMenu && optionsMenu.style.display !== 'none' && 
            !optionsMenu.contains(e.target) && 
            !optionsBtn.contains(e.target)) {
            closeOptionsMenu();
        }
    });
});

// Load connections for new message modal
function loadConnections() {
    const connectionsList = document.getElementById('connectionsList');
    connectionsList.innerHTML = '';
    
    connectionsData.forEach(conn => {
        const connectionItem = document.createElement('div');
        connectionItem.className = 'connection-item';
        connectionItem.onclick = () => startNewConversation(conn);
        
        connectionItem.innerHTML = `
            <div class="connection-avatar-small">${conn.avatar}</div>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-1">${conn.name}</h6>
                <p class="small text-secondary mb-0">${conn.title}</p>
            </div>
            <div class="connection-status">
                <span class="status-dot ${conn.online ? 'online' : 'offline'}" style="margin-right: 0;"></span>
            </div>
        `;
        
        connectionsList.appendChild(connectionItem);
    });
}

// Search connections
function searchConnections() {
    const searchTerm = document.getElementById('recipientSearch').value.toLowerCase();
    const connections = document.querySelectorAll('.connection-item');
    const noResults = document.getElementById('noResults');
    
    let visibleCount = 0;
    
    connections.forEach(conn => {
        const name = conn.querySelector('h6').textContent.toLowerCase();
        const title = conn.querySelector('p').textContent.toLowerCase();
        
        if (name.includes(searchTerm) || title.includes(searchTerm)) {
            conn.style.display = 'flex';
            visibleCount++;
        } else {
            conn.style.display = 'none';
        }
    });
    
    if (visibleCount === 0 && searchTerm !== '') {
        noResults.style.display = 'block';
    } else {
        noResults.style.display = 'none';
    }
}

// New message modal functions
function openNewMessageModal() {
    document.getElementById('newMessageModal').classList.add('active');
    document.getElementById('recipientSearch').value = '';
    searchConnections();
}

function closeNewMessageModal() {
    document.getElementById('newMessageModal').classList.remove('active');
}

// Start new conversation
function startNewConversation(connection) {
    closeNewMessageModal();
    
    // Check if conversation already exists
    const existingConvo = document.querySelector(`[onclick="selectConversation('${connection.id}')"]`);
    
    if (existingConvo) {
        // Select existing conversation
        selectConversation(connection.id);
        showToast(`Opened conversation with ${connection.name}`);
    } else {
        // Create new conversation item
        createConversationItem(connection);
        showToast(`Started new conversation with ${connection.name}`);
    }
}

// Create new conversation item
function createConversationItem(connection) {
    const conversationsList = document.querySelector('.conversations-list');
    
    const newConversation = document.createElement('div');
    newConversation.className = 'conversation-item active';
    newConversation.onclick = () => selectConversation(connection.id);
    
    const now = new Date();
    const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    
    newConversation.innerHTML = `
        <div class="conversation-avatar">${connection.avatar}</div>
        <div class="conversation-content">
            <div class="conversation-header">
                <h6 class="conversation-name fw-bold">${connection.name}</h6>
                <span class="conversation-time">${timeString}</span>
            </div>
            <p class="conversation-preview">
                New conversation started
            </p>
            <div class="conversation-meta">
                <span class="unread-badge">1</span>
                <i class="bi bi-check2"></i>
            </div>
        </div>
    `;
    
    // Remove active class from other conversations
    document.querySelectorAll('.conversation-item').forEach(item => {
        item.classList.remove('active');
    });
    
    // Add to top of list
    conversationsList.insertBefore(newConversation, conversationsList.firstChild);
    
    // Update chat header
    updateChatHeader(connection.name, connection.avatar, connection.online);
    currentContactId = connection.id;
    
    // Clear messages area for new conversation
    const messagesArea = document.getElementById('messagesArea');
    messagesArea.innerHTML = `
        <div class="date-separator">
            <span>Today</span>
        </div>
        <div class="text-center py-5 text-secondary">
            <p>Start a new conversation with ${connection.name}</p>
        </div>
    `;
}

// Select conversation
function selectConversation(contactId) {
    const contact = connectionsData.find(c => c.id === contactId);
    if (!contact) return;
    
    // Remove active class from all conversations
    document.querySelectorAll('.conversation-item').forEach(item => {
        item.classList.remove('active');
    });
    
    // Add active class to selected conversation
    const selectedConvo = document.querySelector(`[onclick="selectConversation('${contactId}')"]`);
    if (selectedConvo) {
        selectedConvo.classList.add('active');
        
        // Clear unread badge
        const unreadBadge = selectedConvo.querySelector('.unread-badge');
        if (unreadBadge) {
            unreadBadge.remove();
        }
    }
    
    // Update chat header
    updateChatHeader(contact.name, contact.avatar, contact.online);
    currentContactId = contactId;
    
    // Load conversation history (in a real app, this would fetch from server)
    loadConversationHistory(contactId);
}

// Update chat header
function updateChatHeader(name, avatar, online = true) {
    const chatHeader = document.querySelector('.chat-header');
    if (chatHeader) {
        const avatarElement = chatHeader.querySelector('.chat-avatar');
        const nameElement = chatHeader.querySelector('h5');
        const statusElement = chatHeader.querySelector('.status-dot');
        
        if (avatarElement) avatarElement.textContent = avatar;
        if (nameElement) nameElement.textContent = name;
        if (statusElement) {
            statusElement.className = `status-dot ${online ? 'online' : 'offline'}`;
            statusElement.nextSibling.textContent = online ? 'Active now' : 'Offline';
        }
    }
}

// Load conversation history
function loadConversationHistory(contactId) {
    const messagesArea = document.getElementById('messagesArea');
    
    // Sample conversation histories
    const histories = {
        'sarah': getSarahConversation(),
        'marcus': getMarcusConversation(),
        'david': getDavidConversation(),
        'lisa': getLisaConversation(),
        'james': getJamesConversation()
    };
    
    messagesArea.innerHTML = histories[contactId] || `
        <div class="date-separator">
            <span>Today</span>
        </div>
        <div class="text-center py-5 text-secondary">
            <p>No messages yet. Start the conversation!</p>
        </div>
    `;
    
    // Scroll to bottom
    messagesArea.scrollTop = messagesArea.scrollHeight;
}

