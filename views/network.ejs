<script>
document.addEventListener('DOMContentLoaded', function() {
    // Connection requests
    const acceptButtons = document.querySelectorAll('.accept-btn');
    const ignoreButtons = document.querySelectorAll('.ignore-btn');
    
    acceptButtons.forEach(button => {
        button.addEventListener('click', function() {
            const requestItem = this.closest('.request-item');
            const name = requestItem.querySelector('h6').textContent;
            
            this.textContent = 'Accepted ✓';
            this.style.background = 'var(--success)';
            this.style.borderColor = 'var(--success)';
            this.disabled = true;
            
            const ignoreBtn = requestItem.querySelector('.ignore-btn');
            ignoreBtn.disabled = true;
            ignoreBtn.textContent = 'Accepted';
            
            showToast(`Connected with ${name}`);
            
            // Update stats
            updateStats('accept');
        });
    });
    
    ignoreButtons.forEach(button => {
        button.addEventListener('click', function() {
            const requestItem = this.closest('.request-item');
            const name = requestItem.querySelector('h6').textContent;
            
            requestItem.style.opacity = '0.5';
            setTimeout(() => {
                requestItem.style.display = 'none';
                showToast(`Ignored request from ${name}`);
                
                // Update stats
                updateStats('ignore');
            }, 300);
        });
    });
    
    // Connect buttons in "People You May Know"
    const connectButtons = document.querySelectorAll('.connect-btn');
    connectButtons.forEach(button => {
        button.addEventListener('click', function() {
            const personItem = this.closest('.person-item');
            const name = personItem.querySelector('h6').textContent;
            
            if (this.textContent === 'Connect') {
                this.textContent = 'Pending';
                this.style.background = 'var(--primary-light)';
                this.style.color = 'var(--primary-color)';
                this.style.border = '1px solid var(--primary-color)';
                
                showToast(`Connection request sent to ${name}`);
            }
        });
    });
    
    // Join buttons for groups
    const joinButtons = document.querySelectorAll('.join-btn');
    joinButtons.forEach(button => {
        button.addEventListener('click', function() {
            const groupItem = this.closest('.group-item');
            const groupName = groupItem.querySelector('h6').textContent;
            
            if (this.textContent === 'Join') {
                this.textContent = 'Joined ✓';
                this.style.background = 'var(--success)';
                this.style.borderColor = 'var(--success)';
                this.disabled = true;
                
                showToast(`Joined ${groupName}`);
            }
        });
    });
    
    // Message buttons on connections
    const messageButtons = document.querySelectorAll('.message-btn');
    messageButtons.forEach(button => {
        button.addEventListener('click', function() {
            const connectionCard = this.closest('.connection-card');
            const name = connectionCard.querySelector('h6').textContent;
            
            showToast(`Starting conversation with ${name}`);
            // In a real app, navigate to messages page with this user
            setTimeout(() => {
                window.location.href = '/messages';
            }, 1000);
        });
    });
    
    // Filter buttons
    const filterButtons = document.querySelectorAll('.filter-btn');
    filterButtons.forEach(button => {
        button.addEventListener('click', function() {
            filterButtons.forEach(btn => btn.classList.remove('active'));
            this.classList.add('active');
            
            const filter = this.textContent.toLowerCase();
            showToast(`Filtering connections by: ${filter}`);
        });
    });
    
    // Sort dropdown
    const sortSelect = document.querySelector('.sort-select');
    if (sortSelect) {
        sortSelect.addEventListener('change', function() {
            showToast(`Sorted by: ${this.value}`);
        });
    }
    
    // Search functionality
    const searchInput = document.querySelector('.search-network-input');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            
            // Filter connection cards
            const connectionCards = document.querySelectorAll('.connection-card');
            connectionCards.forEach(card => {
                const name = card.querySelector('h6').textContent.toLowerCase();
                const title = card.querySelector('p').textContent.toLowerCase();
                
                if (name.includes(searchTerm) || title.includes(searchTerm)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    }
    
    // View all requests
    const viewAllBtn = document.querySelector('.view-all-btn');
    if (viewAllBtn) {
        viewAllBtn.addEventListener('click', function() {
            showToast('Loading all connection requests...');
            // In a real app, load more requests
        });
    }
    
    // Load more connections
    const loadMoreBtn = document.querySelector('.load-more-btn');
    if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
            showToast('Loading more connections...');
            // In a real app, load more connections
        });
    }
    
    // Update stats function
    function updateStats(action) {
        const pendingBadge = document.querySelector('.connection-requests .badge');
        if (pendingBadge) {
            let currentCount = parseInt(pendingBadge.textContent);
            if (action === 'accept' || action === 'ignore') {
                if (currentCount > 0) {
                    currentCount--;
                    pendingBadge.textContent = currentCount + ' new';
                    
                    if (currentCount === 0) {
                        pendingBadge.remove();
                    }
                }
            }
        }
        
        // Update connections count
        const connectionsStat = document.querySelector('.stat-card:first-child .stat-number');
        if (connectionsStat && action === 'accept') {
            let currentConnections = parseInt(connectionsStat.textContent);
            connectionsStat.textContent = currentConnections + 1;
        }
    }
    
    // Toast notification
    function showToast(message) {
        const toast = document.createElement('div');
        toast.className = 'network-toast';
        toast.textContent = message;
        
        toast.style.cssText = `
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: var(--text-dark);
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            z-index: 9999;
            font-size: 0.9rem;
            font-weight: 500;
            animation: slideUp 0.3s ease-out;
        `;
        
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.style.animation = 'slideDown 0.3s ease-out';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }
    
    // Add hover effects
    const connectionCards = document.querySelectorAll('.connection-card');
    connectionCards.forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px)';
            this.style.boxShadow = '0 8px 30px rgba(255, 122, 24, 0.12)';
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
            this.style.boxShadow = '';
        });
    });
});
</script>