<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="fw-bold mb-0">Notifications</h5>
                <button class="btn btn-outline-primary btn-sm fw-bold" onclick="markAllAsRead()">
                    Mark all as read
                </button>
            </div>
            
            <div class="list-group list-group-flush" id="notifications-full-list">
                <div class="text-center py-5" id="notif-loader">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Loading your notifications...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        loadFullNotifications();
    });

    function loadFullNotifications() {
        $.get('/api/notifications', function(data) {
            $('#notif-loader').addClass('d-none');
            const list = $('#notifications-full-list');
            list.empty();

            if (data.length === 0) {
                list.append('<div class="p-5 text-center text-muted">No notifications yet.</div>');
                return;
            }

            data.forEach(notif => {
                const isUnread = !notif.isRead;
                const icon = notif.type === 'message' ? 'bi-chat-dots-fill' : 'bi-briefcase-fill';
                const time = new Date(notif.createdAt).toLocaleDateString();

                list.append(`
                    <div class="list-group-item list-group-item-action border-bottom p-3 ${isUnread ? 'bg-light border-start border-primary border-4' : ''}">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                <i class="bi ${icon} text-primary fs-4"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <p class="mb-1 text-dark">
                                        <strong>${notif.sender?.id?.firstName || 'User'}</strong> 
                                        ${notif.type === 'message' ? 'sent you a new message' : 'updated your application status'}
                                    </p>
                                    <small class="text-muted">${time}</small>
                                </div>
                                <button class="btn btn-sm btn-link p-0 text-decoration-none" onclick="viewNotif('${notif._id}', '${notif.type}')">
                                    View details
                                </button>
                            </div>
                            ${isUnread ? '<span class="badge rounded-circle bg-primary p-1"><span class="visually-hidden">New</span></span>' : ''}
                        </div>
                    </div>
                `);
            });
        });
    }

    function viewNotif(id, type) {
        // Marquer comme lu et rediriger
        $.ajax({
            url: `/api/notifications/${id}/read`,
            type: 'PUT',
            success: function() {
                if (type === 'message') window.location.href = '/inbox';
                else window.location.href = '/jobs';
            }
        });
    }

    function markAllAsRead() {
        // Optionnel : Ajoutez une route API pour tout marquer d'un coup
        alert('Updating all notifications...');
        location.reload();
    }
</script>