            alert('Opening applicant management dashboard...');
            // In a real application, this would navigate to a detailed management view
        }
        
        if (manageApplicantsBtn) {
            manageApplicantsBtn.addEventListener('click', handleManageApplicants);
        }

        // Search functionality
        const searchInput = document.querySelector('.search-input');
        searchInput.addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const applicantCards = document.querySelectorAll('.applicant-card-container, .minimal-applicant');
            
            applicantCards.forEach(card => {
                const text = card.textContent.toLowerCase();
                if (text.includes(searchTerm) || searchTerm === '') {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });

