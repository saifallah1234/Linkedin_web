<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Nexus - Professional Network' %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }
        
        /* Custom styles for the user dropdown */
        .user-dropdown-toggle {
            background: none;
            border: none;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 8px;
            transition: all 0.2s ease;
        }
        
        .user-dropdown-toggle:hover {
            background: rgba(0, 0, 0, 0.05);
        }
        
        .user-info {
            text-align: left;
            line-height: 1.2;
        }
        
        .user-name {
            font-weight: 600;
            font-size: 0.875rem;
            color: #333;
        }
        
        .user-title {
            font-size: 0.75rem;
            color: #666;
        }
        
        .dropdown-menu {
            min-width: 280px;
            border: none;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            padding: 0;
            overflow: hidden;
            margin-top: 8px;
        }
        
        .dropdown-header {
            padding: 16px;
            background: linear-gradient(135deg, #ff7a18 0%, #ff3d00 100%);
            color: white;
        }
        
        .dropdown-header-avatar {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.25rem;
            margin-bottom: 12px;
        }
        
        .dropdown-header-name {
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 4px;
        }
        
        .dropdown-header-title {
            font-size: 0.875rem;
            opacity: 0.9;
        }
        
        .dropdown-item {
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s ease;
        }
        
        .dropdown-item:hover {
            background: rgba(255, 122, 24, 0.1);
        }
        
        .dropdown-item i {
            width: 20px;
            color: #ff7a18;
        }
        
        .dropdown-divider {
            margin: 0;
        }
        
        /* Remove Bootstrap's default dropdown arrow */
        .user-dropdown-toggle.dropdown-toggle::after {
            display: none !important;
        }
        
        /* Custom arrow rotation animation */
        .user-dropdown-toggle .bi-chevron-down {
            transition: transform 0.3s ease;
        }
        
        .user-dropdown-toggle.show .bi-chevron-down {
            transform: rotate(180deg);
        }
        
        /* Ensure proper spacing */
        .nav-icons {
            gap: 20px;
        }
        
        @media (max-width: 768px) {
            .user-info {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <% if (typeof hideNavbar === 'undefined' || hideNavbar === false) { %>
    <nav class="navbar navbar-expand-lg navbar-nexus">
        <div class="container-fluid px-4">
            <!-- Logo -->
            <a class="navbar-brand navbar-brand-nexus fw-bold fs-3" href="/feed">
                Nexus
            </a>

            <!-- Search -->
            <div class="search-container mx-4">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search people, jobs, companies...">
            </div>

            <!-- Navigation Icons -->
            <div class="nav-icons d-flex align-items-center gap-4 ms-auto">
                <a href="/feed" class="nav-icon <%= currentPage === 'home' ? 'active' : '' %>">
                    <i class="bi bi-house-door fs-5"></i>
                    <span class="nav-label">Home</span>
                </a>
                <a href="/network" class="nav-icon <%= currentPage === 'network' ? 'active' : '' %>">
                    <i class="bi bi-people fs-5"></i>
                    <span class="nav-label">Network</span>
                </a>
                <a href="/jobs" class="nav-icon <%= currentPage === 'jobs' ? 'active' : '' %>">
                    <i class="bi bi-briefcase fs-5"></i>
                    <span class="nav-label">Jobs</span>
                </a>
                <a href="/messages" class="nav-icon <%= currentPage === 'messages' ? 'active' : '' %>">
                    <i class="bi bi-chat-dots fs-5"></i>
                    <span class="nav-label">Messages</span>
                </a>
                <a href="/notifications" class="nav-icon <%= currentPage === 'notifications' ? 'active' : '' %>">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="nav-label">Notifications</span>
                </a>

                <!-- User Menu with Profile Info -->
                <div class="dropdown">
                    <button class="btn user-dropdown-toggle dropdown-toggle d-flex align-items-center" 
                            type="button" 
                            id="userDropdown"
                            data-bs-toggle="dropdown" 
                            aria-expanded="false">
                        <div class="user-avatar rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 36px; height: 36px; background: var(--orange-gradient);">
                            <span class="text-white fw-bold fs-6">AJ</span>
                        </div>
                        <div class="user-info d-none d-md-block">
                            <div class="user-name">Alex Johnson</div>
                            <div class="user-title">View Profile</div>
                        </div>
                        <i class="bi bi-chevron-down ms-1 text-secondary"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                        <!-- Dropdown Header with User Info -->
                        <li class="dropdown-header">
                            <div class="dropdown-header-avatar">AJ</div>
                            <div class="dropdown-header-name">Alex Johnson</div>
                            <div class="dropdown-header-title">Senior Product Designer at TechCorp</div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/profile"><i class="bi bi-person"></i>Your Profile</a></li>
                        <li><a class="dropdown-item" href="/settings"><i class="bi bi-gear"></i>Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-right"></i>Sign Out</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
    <% } %>
    <!-- Bootstrap Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>