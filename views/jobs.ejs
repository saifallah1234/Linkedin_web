<%- include('partials/header', { currentPage: 'jobs', title: 'Jobs - Nexus' }) %>

<div class="container py-4">
    <!-- Header avec titre et recherche -->
    <div class="jobs-header mb-5">
        <h1 class="fw-bold mb-2">Jobs</h1>
        <p class="text-secondary mb-4">Find your next opportunity</p>
        
        <!-- Tabs -->
        <div class="jobs-tabs mb-4">
            <div class="d-flex gap-2">
                <button class="jobs-tab active">For You</button>
                <button class="jobs-tab">Applied</button>
            </div>
        </div>
        
        <!-- Barre de recherche -->
        <div class="search-jobs-container mb-4">
            <div class="search-jobs-wrapper">
                <i class="bi bi-search search-jobs-icon"></i>
                <input type="text" class="search-jobs-input" placeholder="Search jobs...">
            </div>
            <div class="filter-dropdown ms-3">
                <select class="form-select filter-select">
                    <option selected>Most Relevant</option>
                    <option>Most Recent</option>
                    <option>Salary: High to Low</option>
                    <option>Easy Apply</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Job Card 1 -->
            <div class="job-card-nexus mb-4">
                <div class="job-card-header">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <h3 class="job-title mb-0">Senior Product Designer</h3>
                                <span class="new-badge">New</span>
                                <span class="match-badge">95% Match</span>
                            </div>
                            <h4 class="company-name mb-2">TechCorp</h4>
                        </div>
                        <button class="save-job-btn">
                            <i class="bi bi-bookmark"></i>
                        </button>
                    </div>
                    
                    <div class="job-meta mb-3">
                        <span class="meta-item">
                            <i class="bi bi-geo-alt"></i> San Francisco, CA
                        </span>
                        <span class="meta-item">
                            <i class="bi bi-briefcase"></i> Full-time
                        </span>
                        <span class="meta-item">
                            <i class="bi bi-cash"></i> $150k - $200k
                        </span>
                        <span class="meta-item">
                            <i class="bi bi-clock"></i> 2 hours ago
                        </span>
                    </div>
                    
                    <p class="job-description mb-3">
                        We're looking for a Senior Product Designer to join our growing team. You'll work on challenging problems and shape the future of our product.
                    </p>
                    
                    <div class="job-skills mb-4">
                        <span class="skill-tag">Figma</span>
                        <span class="skill-tag">Design Systems</span>
                        <span class="skill-tag">Prototyping</span>
                        <span class="skill-tag">User Research</span>
                    </div>
                    
                    <div class="job-footer d-flex justify-content-between align-items-center">
                        <div class="applicants-count">
                            <i class="bi bi-people"></i> 24 applicants
                        </div>
                        <div class="job-actions d-flex gap-2">
                            <button class="view-details-btn" onclick="openJobDetails('job1')">View Details</button>
                            <button class="apply-now-btn" onclick="openApplyModal('job1')">Apply Now</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Job Card 2 -->
            <div class="job-card-nexus mb-4">
                <div class="job-card-header">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <h3 class="job-title mb-0">UX/UI Designer</h3>
                                <span class="new-badge">New</span>
                            </div>
                            <h4 class="company-name mb-2">StartupXYZ</h4>
                        </div>
                        <button class="save-job-btn">
                            <i class="bi bi-bookmark"></i>
                        </button>
                    </div>
                    
                    <div class="job-meta mb-3">
                        <span class="meta-item">
                            <i class="bi bi-geo-alt"></i> New York, NY
                        </span>
                        <span class="meta-item">
                            <i class="bi bi-briefcase"></i> Full-time
                        </span>
                        <span class="meta-item">
                            <i class="bi bi-cash"></i> $120k - $160k
                        </span>
                        <span class="meta-item">
                            <i class="bi bi-clock"></i> 1 day ago
                        </span>
                    </div>
                    
                    <p class="job-description mb-3">
                        Join our fast-growing startup as a UX/UI Designer. Work directly with founders and make an impact from day one.
                    </p>
                    
                    <div class="job-skills mb-4">
                        <span class="skill-tag">UI Design</span>
                        <span class="skill-tag">User Testing</span>
                        <span class="skill-tag">Wireframing</span>
                        <span class="skill-tag">Adobe XD</span>
                    </div>
                    
                    <div class="job-footer d-flex justify-content-between align-items-center">
                        <div class="applicants-count">
                            <i class="bi bi-people"></i> 56 applicants
                        </div>
                        <div class="job-actions d-flex gap-2">
                            <button class="view-details-btn" onclick="openJobDetails('job2')">View Details</button>
                            <button class="apply-now-btn" onclick="openApplyModal('job2')">Apply Now</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Job Preferences -->
            <div class="job-preferences-card card-nexus mb-4">
                <div class="card-header">
                    <h6 class="mb-0 fw-bold">Job Preferences</h6>
                </div>
                <div class="card-body">
                    <div class="preference-item mb-3">
                        <label class="preference-label">Role</label>
                        <div class="preference-value fw-medium">Product Designer</div>
                    </div>
                    <div class="preference-item mb-3">
                        <label class="preference-label">Location</label>
                        <div class="preference-value fw-medium">San Francisco, CA</div>
                    </div>
                    <div class="preference-item mb-3">
                        <label class="preference-label">Job Type</label>
                        <div class="preference-value fw-medium">Full-time</div>
                    </div>
                    <div class="preference-item mb-3">
                        <label class="preference-label">Remote</label>
                        <div class="preference-value fw-medium">Open to remote</div>
                    </div>
                    <button class="edit-preferences-btn w-100 mt-3" onclick="showToast('Opening preferences editor')">
                        Edit Preferences
                    </button>
                </div>
            </div>

            <!-- Recommended Companies -->
            <div class="recommended-companies card-nexus mb-4">
                <div class="card-header">
                    <h6 class="mb-0 fw-bold">Recommended Companies</h6>
                </div>
                <div class="card-body">
                    <div class="company-item mb-3" onclick="showToast('Viewing jobs at TechCorp')">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">TechCorp</h6>
                                <p class="company-type small mb-0">Technology</p>
                            </div>
                            <span class="open-roles-badge">15 open roles</span>
                        </div>
                    </div>
                    
                    <div class="company-item mb-3" onclick="showToast('Viewing jobs at DesignStudio')">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">DesignStudio</h6>
                                <p class="company-type small mb-0">Design Agency</p>
                            </div>
                            <span class="open-roles-badge">8 open roles</span>
                        </div>
                    </div>
                    
                    <div class="company-item" onclick="showToast('Viewing jobs at FinanceApp')">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">FinanceApp</h6>
                                <p class="company-type small mb-0">FinTech</p>
                            </div>
                            <span class="open-roles-badge">12 open roles</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Career Resources -->
            <div class="career-resources card-nexus">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Career Resources</h6>
                   
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Job Details Modal -->
<div class="edit-form-overlay" id="jobDetailsModal">
    <div class="edit-form-container" style="max-width: 800px;">
        <div class="edit-form-header">
            <h3 class="edit-form-title" id="jobDetailsTitle">Senior Product Designer</h3>
            <button class="close-form-btn" onclick="closeJobDetails()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div id="jobDetailsContent" class="p-3">
            <!-- Dynamic content will be inserted here -->
        </div>
        <div class="form-actions">
            <button type="button" class="btn-save" onclick="openApplyModal(currentJobId)">Apply Now</button>
            <button type="button" class="btn-cancel" onclick="closeJobDetails()">Close</button>
        </div>
    </div>
</div>

<!-- Apply Modal -->
<div class="edit-form-overlay" id="applyModal">
    <div class="edit-form-container" style="max-width: 700px;">
        <div class="edit-form-header">
            <h3 class="edit-form-title" id="applyJobTitle">Apply for Senior Product Designer</h3>
            <button class="close-form-btn" onclick="closeApplyModal()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <form id="applyForm">
            <div class="p-3">
                <!-- Resume Section -->
                <div class="form-group mb-4">
                    <label class="form-label mb-3 fw-bold">Resume *</label>
                    <div class="resume-options d-flex gap-3 mb-3">
                        <button type="button" class="resume-option-btn" onclick="loadResume()">
                            <i class="bi bi-upload me-2"></i>
                            Load Resume
                        </button>
                        <button type="button" class="resume-option-btn" onclick="generateResume()">
                            <i class="bi bi-magic me-2"></i>
                            Generate Resume
                        </button>
                    </div>
                    <div class="resume-preview mt-3 p-3 border rounded" id="resumePreview" style="display: none;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Current_Resume.pdf</span>
                            <button type="button" class="btn-remove-resume" onclick="removeResume()">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Cover Letter Section -->
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Cover Letter (Optional)</label>
                    <textarea class="form-input form-textarea" placeholder="Write a cover letter..." rows="4"></textarea>
                </div>

                <!-- Video Introduction Section -->
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Video Introduction (Optional)</label>
                    <div class="video-upload-area p-4 border rounded text-center mb-3" 
                         onclick="document.getElementById('videoInput').click()"
                         style="cursor: pointer; border-style: dashed !important;">
                        <div class="upload-icon mb-2">
                            <i class="bi bi-camera-video" style="font-size: 2rem; color: var(--text-light);"></i>
                        </div>
                        <p class="upload-text mb-1">Click to upload a video introduction</p>
                        <p class="upload-hint small text-secondary">Max 2 minutes • MP4, MOV • Up to 100MB</p>
                        <input type="file" id="videoInput" accept="video/*" style="display: none;" onchange="previewVideo(this)">
                    </div>
                    <div class="video-preview mt-3" id="videoPreview" style="display: none;">
                        <div class="d-flex align-items-center gap-3 p-3 border rounded">
                            <i class="bi bi-play-circle" style="font-size: 1.5rem; color: var(--primary-color);"></i>
                            <div class="flex-grow-1">
                                <p class="mb-1" id="videoFileName">video_introduction.mp4</p>
                                <p class="small text-secondary mb-0" id="videoFileSize">45.2 MB</p>
                            </div>
                            <button type="button" class="btn-remove-video" onclick="removeVideo()">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Additional Questions -->
                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Additional Information</label>
                    <div class="mb-3">
                        <label class="form-label small">Years of Experience</label>
                        <input type="number" class="form-input" placeholder="e.g., 5">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Portfolio URL</label>
                        <input type="url" class="form-input" placeholder="https://yourportfolio.com">
                    </div>
                    <div>
                        <label class="form-label small">Why are you interested in this role?</label>
                        <textarea class="form-input form-textarea" rows="3" placeholder="Briefly explain..."></textarea>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-save">Submit Application</button>
                <button type="button" class="btn-cancel" onclick="closeApplyModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>

<style>
/* Resume Option Buttons */
.resume-options {
    display: flex;
    gap: 12px;
}

.resume-option-btn {
    flex: 1;
    padding: 15px 20px;
    background: var(--light-bg);
    border: 2px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-dark);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.resume-option-btn:hover {
    background: var(--primary-light);
    border-color: var(--primary-color);
    color: var(--primary-color);
    transform: translateY(-2px);
}

/* Video Upload Area */
.video-upload-area {
    transition: all 0.3s ease;
}

.video-upload-area:hover {
    border-color: var(--primary-color) !important;
    background: var(--primary-light);
}

/* Remove buttons */
.btn-remove-resume, .btn-remove-video {
    background: transparent;
    border: none;
    color: var(--text-light);
    cursor: pointer;
    transition: color 0.2s ease;
}

.btn-remove-resume:hover, .btn-remove-video:hover {
    color: var(--danger);
}

/* Job Details Styles */
.job-detail-section {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
}

.job-detail-section:last-child {
    border-bottom: none;
}

.detail-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 10px;
}

.detail-content {
    color: var(--text-dark);
    line-height: 1.6;
}

.requirements-list {
    list-style: none;
    padding: 0;
}

.requirements-list li {
    padding: 5px 0;
    padding-left: 24px;
    position: relative;
}

.requirements-list li:before {
    content: "•";
    color: var(--primary-color);
    position: absolute;
    left: 0;
    font-weight: bold;
}

.benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
}

.benefit-item {
    background: var(--primary-light);
    color: var(--primary-color);
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
}

/* Toast styles */
.custom-toast {
    position: fixed;
    top: 20px;
    right: 20px;
    background: white;
    padding: 12px 20px;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    border-left: 4px solid var(--primary-color);
    z-index: 9999;
    animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

@keyframes slideOut {
    from {
        transform: translateX(0);
        opacity: 1;
    }
    to {
        transform: translateX(100%);
        opacity: 0;
    }
}
</style>

<script>
let currentJobId = null;
let currentJobTitle = null;

// Job Details Functions
function openJobDetails(jobId) {
    currentJobId = jobId;
    const modal = document.getElementById('jobDetailsModal');
    const title = document.getElementById('jobDetailsTitle');
    const content = document.getElementById('jobDetailsContent');
    
    // Set job title based on ID
    if (jobId === 'job1') {
        currentJobTitle = 'Senior Product Designer';
        title.textContent = 'Senior Product Designer - TechCorp';
        content.innerHTML = getJob1Details();
    } else if (jobId === 'job2') {
        currentJobTitle = 'UX/UI Designer';
        title.textContent = 'UX/UI Designer - StartupXYZ';
        content.innerHTML = getJob2Details();
    }
    
    modal.classList.add('active');
}

function closeJobDetails() {
    document.getElementById('jobDetailsModal').classList.remove('active');
}

// Job 1 Details
function getJob1Details() {
    return `
        <div class="job-detail-section">
            <h6 class="detail-title">About the Role</h6>
            <p class="detail-content">
                We're looking for a Senior Product Designer to lead design initiatives for our core product. 
                You'll work closely with product managers, engineers, and other designers to create beautiful, 
                intuitive experiences that our users love.
            </p>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Responsibilities</h6>
            <ul class="requirements-list">
                <li>Lead the design of new features and improvements to our product</li>
                <li>Create wireframes, prototypes, and high-fidelity designs</li>
                <li>Conduct user research and usability testing</li>
                <li>Collaborate with engineering teams to ensure quality implementation</li>
                <li>Contribute to and maintain our design system</li>
                <li>Mentor junior designers and share best practices</li>
            </ul>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Requirements</h6>
            <ul class="requirements-list">
                <li>5+ years of product design experience</li>
                <li>Strong portfolio demonstrating design process and impact</li>
                <li>Expertise in Figma and prototyping tools</li>
                <li>Experience with design systems</li>
                <li>Excellent communication and collaboration skills</li>
                <li>Experience in SaaS or B2B products preferred</li>
            </ul>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Benefits</h6>
            <div class="benefits-grid">
                <div class="benefit-item">Health Insurance</div>
                <div class="benefit-item">Flexible Hours</div>
                <div class="benefit-item">Remote Work</div>
                <div class="benefit-item">Stock Options</div>
                <div class="benefit-item">Learning Budget</div>
                <div class="benefit-item">Unlimited PTO</div>
            </div>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Application Process</h6>
            <p class="detail-content">
                1. Submit application with resume<br>
                2. Initial screening call (30 min)<br>
                3. Portfolio review & design challenge<br>
                4. On-site interviews (virtual)<br>
                5. Offer decision within 1 week
            </p>
        </div>
    `;
}

// Job 2 Details
function getJob2Details() {
    return `
        <div class="job-detail-section">
            <h6 class="detail-title">About the Role</h6>
            <p class="detail-content">
                Join our fast-growing startup as a UX/UI Designer. You'll be the first designer on the team 
                and have the opportunity to shape our product from the ground up. Work directly with founders 
                and make an impact from day one.
            </p>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Responsibilities</h6>
            <ul class="requirements-list">
                <li>Design user interfaces for web and mobile applications</li>
                <li>Create user flows, wireframes, and prototypes</li>
                <li>Conduct user interviews and usability tests</li>
                <li>Work closely with engineering to implement designs</li>
                <li>Establish design processes and best practices</li>
                <li>Help build our design system from scratch</li>
            </ul>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Requirements</h6>
            <ul class="requirements-list">
                <li>3+ years of UX/UI design experience</li>
                <li>Portfolio showing strong visual design skills</li>
                <li>Proficiency in Figma, Sketch, or Adobe XD</li>
                <li>Understanding of user-centered design principles</li>
                <li>Ability to work in a fast-paced startup environment</li>
                <li>Excellent problem-solving skills</li>
            </ul>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Benefits</h6>
            <div class="benefits-grid">
                <div class="benefit-item">Competitive Salary</div>
                <div class="benefit-item">Equity Package</div>
                <div class="benefit-item">Remote First</div>
                <div class="benefit-item">Health & Wellness</div>
                <div class="benefit-item">Flexible Schedule</div>
                <div class="benefit-item">Learning Stipend</div>
            </div>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Our Culture</h6>
            <p class="detail-content">
                We're a small, passionate team building something we believe in. We value creativity, 
                collaboration, and ownership. You'll have autonomy to make decisions and see your work 
                directly impact our users.
            </p>
        </div>
    `;
}

// Apply Modal Functions
function openApplyModal(jobId) {
    currentJobId = jobId;
    const modal = document.getElementById('applyModal');
    const title = document.getElementById('applyJobTitle');
    
    // Close job details modal if open
    closeJobDetails();
    
    // Set title based on current job
    if (currentJobTitle) {
        title.textContent = `Apply for ${currentJobTitle}`;
    } else {
        title.textContent = jobId === 'job1' ? 'Apply for Senior Product Designer' : 'Apply for UX/UI Designer';
    }
    
    // Reset form
    document.getElementById('applyForm').reset();
    document.getElementById('resumePreview').style.display = 'none';
    document.getElementById('videoPreview').style.display = 'none';
    
    modal.classList.add('active');
}

function closeApplyModal() {
    document.getElementById('applyModal').classList.remove('active');
}

// Resume Functions
function loadResume() {
    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = '.pdf,.doc,.docx';
    fileInput.onchange = function(e) {
        const file = e.target.files[0];
        if (file) {
            showResumePreview(file.name, file.size);
            showToast('Resume uploaded successfully');
        }
    };
    fileInput.click();
}

function generateResume() {
    showToast('Generating resume from your profile...');
    
    // Simulate resume generation
    setTimeout(() => {
        showResumePreview('Generated_Resume.pdf', '245 KB');
        showToast('Resume generated from your profile');
    }, 1000);
}

function showResumePreview(fileName, fileSize) {
    const preview = document.getElementById('resumePreview');
    preview.querySelector('span').textContent = fileName;
    preview.style.display = 'block';
}

function removeResume() {
    document.getElementById('resumePreview').style.display = 'none';
    showToast('Resume removed');
}

// Video Functions
function previewVideo(input) {
    if (input.files && input.files[0]) {
        const file = input.files[0];
        const fileName = file.name;
        const fileSize = (file.size / (1024 * 1024)).toFixed(1) + ' MB';
        
        document.getElementById('videoFileName').textContent = fileName;
        document.getElementById('videoFileSize').textContent = fileSize;
        document.getElementById('videoPreview').style.display = 'block';
        
        showToast('Video uploaded successfully');
    }
}

function removeVideo() {
    document.getElementById('videoPreview').style.display = 'none';
    document.getElementById('videoInput').value = '';
    showToast('Video removed');
}

// Form Submission
document.getElementById('applyForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Get form data
    const resumeUploaded = document.getElementById('resumePreview').style.display !== 'none';
    const videoUploaded = document.getElementById('videoPreview').style.display !== 'none';
    
    if (!resumeUploaded) {
        showToast('Please upload or generate a resume', 'warning');
        return;
    }
    
    // Show success message
    showToast(`Application submitted successfully for ${currentJobTitle || 'the position'}!`);
    
    // Update job card button
    const applyBtn = document.querySelector(`[onclick="openApplyModal('${currentJobId}')"]`);
    if (applyBtn) {
        applyBtn.textContent = 'Applied ✓';
        applyBtn.style.background = 'var(--success)';
        applyBtn.style.borderColor = 'var(--success)';
        applyBtn.disabled = true;
        applyBtn.setAttribute('onclick', '');
    }
    
    // Close modal after delay
    setTimeout(() => {
        closeApplyModal();
    }, 1500);
});

// Save job button functionality
document.addEventListener('DOMContentLoaded', function() {
    const saveButtons = document.querySelectorAll('.save-job-btn');
    saveButtons.forEach(button => {
        button.addEventListener('click', function() {
            const icon = this.querySelector('i');
            if (icon.classList.contains('bi-bookmark')) {
                icon.classList.remove('bi-bookmark');
                icon.classList.add('bi-bookmark-fill');
                this.style.color = 'var(--primary-color)';
                showToast('Job saved to your list');
            } else {
                icon.classList.remove('bi-bookmark-fill');
                icon.classList.add('bi-bookmark');
                this.style.color = '';
                showToast('Job removed from saved list');
            }
        });
    });

    // Tabs functionality
    const jobTabs = document.querySelectorAll('.jobs-tab');
    jobTabs.forEach(tab => {
        tab.addEventListener('click', function() {
            jobTabs.forEach(t => t.classList.remove('active'));
            this.classList.add('active');
            showToast(`Showing ${this.textContent} jobs`);
        });
    });

    // Filter select
    const filterSelect = document.querySelector('.filter-select');
    if (filterSelect) {
        filterSelect.addEventListener('change', function() {
            showToast(`Filter changed to: ${this.value}`);
        });
    }

    // Job cards hover effect
    const jobCards = document.querySelectorAll('.job-card-nexus');
    jobCards.forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px)';
            this.style.boxShadow = '0 8px 30px rgba(255, 122, 24, 0.15)';
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
            this.style.boxShadow = '';
        });
    });

    // Company items hover effect
    const companyItems = document.querySelectorAll('.company-item');
    companyItems.forEach(item => {
        item.addEventListener('mouseenter', function() {
            this.style.background = 'var(--primary-light)';
            this.style.borderRadius = '8px';
            this.style.padding = '12px';
            this.style.margin = '-12px -12px';
        });
        
        item.addEventListener('mouseleave', function() {
            this.style.background = '';
            this.style.padding = '';
            this.style.margin = '';
        });
    });
});

// Toast notification function
function showToast(message, type = 'success') {
    // Remove existing toast
    const existingToast = document.querySelector('.custom-toast');
    if (existingToast) {
        existingToast.remove();
    }
    
    // Create new toast
    const toast = document.createElement('div');
    toast.className = 'custom-toast';
    
    let icon = 'bi-check-circle-fill';
    if (type === 'warning') {
        icon = 'bi-exclamation-triangle-fill';
    }
    
    toast.innerHTML = `
        <div class="toast-content">
            <i class="bi ${icon} me-2"></i>
            ${message}
        </div>
    `;
    
    if (type === 'warning') {
        toast.style.borderLeftColor = 'var(--warning)';
    }
    
    document.body.appendChild(toast);
    
    // Remove after 3 seconds
    setTimeout(() => {
        toast.style.animation = 'slideOut 0.3s ease-out';
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

// Close modals when clicking outside
document.querySelectorAll('.edit-form-overlay').forEach(modal => {
    modal.addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.remove('active');
        }
    });
});
</script>