<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LinkedIn Clone | Engineering Project</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-1">
        <div class="container">
            <a class="navbar-brand text-primary fw-bold fs-3" href="/jobs"><i class="bi bi-linkedin"></i></a>
            <div class="ms-auto d-flex align-items-center">
                <a href="/jobs" class="nav-link px-3 text-center d-none d-md-block">
                    <i class="bi bi-briefcase-fill d-block fs-4"></i><small>Jobs</small>
                </a>
                <a href="/inbox" class="nav-link px-3 text-center d-none d-md-block">
                    <i class="bi bi-chat-dots-fill d-block fs-4"></i><small>Messaging</small>
                </a>
                <div class="dropdown">
                    <a href="#" class="nav-link px-3 text-center position-relative" id="notifDropdown" data-bs-toggle="dropdown">
                        <i class="bi bi-bell-fill d-block fs-4"></i>
                        <span id="notif-badge" class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-danger d-none">0</span>
                        <small>Notifications</small>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" id="notif-preview-list" style="width: 300px;">
                        <li><h6 class="dropdown-header">Notifications</h6></li>
                        <div id="notif-items"></div>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-center text-primary fw-bold" href="/notifications">View all</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <%- body %> </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/notifications.js"></script>
</body>
</html>