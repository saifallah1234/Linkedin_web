<script>
// Same modal functions as before, but with company-specific forms
function openUploadPhoto() {
    document.getElementById('uploadPhotoModal').classList.add('active');
}

function closeUploadPhoto() {
    document.getElementById('uploadPhotoModal').classList.remove('active');
    document.getElementById('imagePreview').classList.remove('active');
    document.getElementById('imagePreview').src = '';
}

function openEditForm(type, id = '') {
    const modal = document.getElementById('editFormModal');
    const title = document.getElementById('editFormTitle');
    const formContent = document.getElementById('formContent');
    
    let formHTML = '';
    
    switch(type) {
        case 'company':
            title.textContent = 'Edit Company Profile';
            formHTML = `
                <div class="form-group">
                    <label class="form-label">Company Name</label>
                    <input type="text" class="form-input" value="TechCorp" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Industry</label>
                    <input type="text" class="form-input" value="Technology • Software Development • SaaS">
                </div>
                <div class="form-group">
                    <label class="form-label">Headquarters</label>
                    <input type="text" class="form-input" value="San Francisco, CA">
                </div>
                <div class="form-group">
                    <label class="form-label">Company Size</label>
                    <input type="text" class="form-input" value="1,000+ employees">
                </div>
                <div class="form-group">
                    <label class="form-label">Founded</label>
                    <input type="number" class="form-input" value="2015">
                </div>
            `;
            break;
            
        case 'about':
            title.textContent = 'Edit Company Description';
            formHTML = `
                <div class="form-group">
                    <label class="form-label">Company Description</label>
                    <textarea class="form-input form-textarea">TechCorp is a leading technology company specializing in innovative software solutions and SaaS products. We're on a mission to revolutionize how businesses operate through cutting-edge technology and user-centric design.

With over 1,000 employees across 3 continents, we've helped 5,000+ companies streamline their operations and boost productivity by an average of 40%.

Our culture is built on innovation, collaboration, and continuous learning. We believe in empowering our employees to do their best work in a supportive, inclusive environment.</textarea>
                </div>
            `;
            break;
            
        case 'job':
            title.textContent = id === 'add' ? 'Post New Job' : 'Edit Job Opening';
            formHTML = `
                <div class="form-group">
                    <label class="form-label">Job Title</label>
                    <input type="text" class="form-input" value="${id === 'add' ? '' : 'Senior Product Designer'}" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Department</label>
                    <input type="text" class="form-input" value="${id === 'add' ? '' : 'Design Team'}">
                </div>
                <div class="form-group">
                    <label class="form-label">Employment Type</label>
                    <select class="form-input">
                        <option>Full-time</option>
                        <option>Part-time</option>
                        <option>Contract</option>
                        <option>Internship</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Location</label>
                    <input type="text" class="form-input" value="${id === 'add' ? '' : 'San Francisco, CA or Remote'}">
                </div>
                <div class="form-group">
                    <label class="form-label">Salary Range</label>
                    <input type="text" class="form-input" value="${id === 'add' ? '' : '$140,000 - $180,000'}">
                </div>
                <div class="form-group">
                    <label class="form-label">Job Description</label>
                    <textarea class="form-input form-textarea">${id === 'add' ? '' : 'Looking for an experienced designer to lead our design system and create intuitive user experiences. 5+ years experience required.'}</textarea>
                </div>
            `;
            break;
            
        case 'post':
            title.textContent = id === 'add' ? 'Create Company Post' : 'Edit Company Post';
            formHTML = `
                <div class="form-group">
                    <label class="form-label">Post Title</label>
                    <input type="text" class="form-input" value="${id === 'add' ? '' : 'Announcing our Series C Funding!'}" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Post Content</label>
                    <textarea class="form-input form-textarea">${id === 'add' ? '' : 'We\'re excited to announce that we\'ve raised $50M in Series C funding led by Sequoia Capital! This investment will accelerate our product development and global expansion.'}</textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Post Date</label>
                    <input type="date" class="form-input" value="${id === 'add' ? '' : '2024-01-15'}">
                </div>
            `;
            break;
            
        case 'contact':
            title.textContent = 'Edit Contact Information';
            formHTML = `
                <div class="form-group">
                    <label class="form-label">Website</label>
                    <input type="url" class="form-input" value="www.techcorp.com">
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-input" value="careers@techcorp.com">
                </div>
                <div class="form-group">
                    <label class="form-label">Phone</label>
                    <input type="tel" class="form-input" value="+1 (555) 987-6543">
                </div>
                <div class="form-group">
                    <label class="form-label">LinkedIn</label>
                    <input type="url" class="form-input" value="linkedin.com/company/techcorp">
                </div>
                <div class="form-group">
                    <label class="form-label">Address</label>
                    <textarea class="form-input form-textarea">123 Tech Street, San Francisco, CA 94107</textarea>
                </div>
            `;
            break;
            
        case 'culture':
            title.textContent = 'Edit Company Culture';
            formHTML = `
                <div class="form-group">
                    <label class="form-label">Culture Values</label>
                    <textarea class="form-input form-textarea" placeholder="Enter culture values, one per line">Innovation
Collaboration
Growth Mindset
Work-Life Balance
Diversity & Inclusion
Remote-Friendly</textarea>
                </div>
            `;
            break;
            
        case 'benefit':
            title.textContent = id === 'add' ? 'Add Employee Benefit' : 'Edit Employee Benefit';
            formHTML = `
                <div class="form-group">
                    <label class="form-label">Benefit Name</label>
                    <input type="text" class="form-input" value="${id === 'add' ? '' : 'Health & Wellness'}" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Benefit Description</label>
                    <textarea class="form-input form-textarea">${id === 'add' ? '' : 'Comprehensive medical, dental, and vision insurance. Mental health support and wellness programs.'}</textarea>
                </div>
            `;
            break;
    }
    
    formContent.innerHTML = formHTML;
    modal.classList.add('active');
}

function closeEditForm() {
    document.getElementById('editFormModal').classList.remove('active');
}

// Same image upload functions
function previewImage(input) {
    const preview = document.getElementById('imagePreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.src = e.target.result;
            preview.classList.add('active');
        }
        reader.readAsDataURL(input.files[0]);
    }
}

function uploadPhoto() {
    const fileInput = document.getElementById('fileInput');
    if (fileInput.files.length > 0) {
        alert('Company logo uploaded successfully!');
        closeUploadPhoto();
    } else {
        alert('Please select a logo first.');
    }
}

function removePhoto() {
    if (confirm('Are you sure you want to remove your company logo?')) {
        alert('Company logo removed.');
        closeUploadPhoto();
    }
}

// Form submission
document.getElementById('editProfileForm').addEventListener('submit', function(e) {
    e.preventDefault();
    alert('Changes saved successfully!');
    closeEditForm();
});

// Close modals when clicking outside
document.querySelectorAll('.edit-form-overlay').forEach(modal => {
    modal.addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.remove('active');
        }
    });
});

// Add department functionality
document.querySelector('.add-skill-btn').addEventListener('click', function() {
    const input = document.querySelector('.skill-input');
    const departmentName = input.value.trim();
    
    if (departmentName) {
        const skillsGrid = document.querySelector('.skills-grid');
        const newSkill = document.createElement('div');
        newSkill.className = 'skill-tag';
        newSkill.innerHTML = `
            ${departmentName}
            <div class="skill-actions">
                <button class="skill-btn edit" title="Edit">
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="skill-btn delete" title="Delete">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        `;
        skillsGrid.appendChild(newSkill);
        input.value = '';
        
        newSkill.querySelector('.skill-btn.delete').addEventListener('click', function() {
            newSkill.remove();
        });
    }
});
</script>