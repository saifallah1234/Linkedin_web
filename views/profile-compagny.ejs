<!-- Upload Logo Modal (same as before, just with company context) -->
<div class="edit-form-overlay" id="uploadPhotoModal">
    <div class="edit-form-container">
        <div class="upload-modal-content">
            <div class="edit-form-header">
                <h3 class="edit-form-title">Upload Company Logo</h3>
                <button class="close-form-btn" onclick="closeUploadPhoto()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="upload-area" onclick="document.getElementById('fileInput').click()">
                <div class="upload-icon">
                    <i class="bi bi-cloud-arrow-up"></i>
                </div>
                <p class="upload-text">Click to upload or drag and drop</p>
                <p class="upload-hint">PNG, JPG or GIF (Max 5MB)</p>
                <input type="file" id="fileInput" accept="image/*" style="display: none;" onchange="previewImage(this)">
            </div>
            <img id="imagePreview" class="upload-preview" src="" alt="Preview">
            <div class="upload-actions">
                <button class="btn-upload" onclick="uploadPhoto()">Upload Logo</button>
                <button class="btn-remove" onclick="removePhoto()">Remove Current</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Form Modal (same as before, but with company-specific forms) -->
<div class="edit-form-overlay" id="editFormModal">
    <div class="edit-form-container">
        <div class="edit-form-header">
            <h3 class="edit-form-title" id="editFormTitle">Edit Company Profile</h3>
            <button class="close-form-btn" onclick="closeEditForm()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <form id="editProfileForm">
            <div id="formContent">
                <!-- Dynamic form content will be inserted here -->
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-save">Save Changes</button>
                <button type="button" class="btn-cancel" onclick="closeEditForm()">Cancel</button>
            </div>
        </form>
    </div>
</div>

