<%- include('partials/header') %>

<div class="company-posts-social-layout">
    <!-- Header -->
    <div style="margin-bottom: 30px;">
        <h1 style="font-size: 28px; font-weight: 700; color: var(--text-dark); margin-bottom: 5px;">Company Posts</h1>
        <p style="font-size: 14px; color: var(--text-light); font-weight: 400;">Manage your posts, announcements, and content</p>
    </div>

    <!-- Stats Row -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 30px;">
        <div style="background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: var(--text-dark); margin-bottom: 5px;">24</div>
            <div style="font-size: 11px; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Total Posts</div>
        </div>
        <div style="background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: var(--text-dark); margin-bottom: 5px;">12.6K</div>
            <div style="font-size: 11px; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Total Views</div>
        </div>
        <div style="background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: var(--text-dark); margin-bottom: 5px;">902</div>
            <div style="font-size: 11px; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Total Likes</div>
        </div>
        <div style="background: white; border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: var(--text-dark); margin-bottom: 5px;">4.2%</div>
            <div style="font-size: 11px; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Engagement Rate</div>
        </div>
    </div>

    <!-- Tabs -->
    <div style="display: flex; gap: 20px; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid var(--border-color);">
        <button style="background: transparent; border: none; color: var(--primary-color); font-size: 14px; font-weight: 600; cursor: pointer; padding: 5px 0; position: relative;">
            Published <span style="font-size: 12px; color: var(--text-light);">(4)</span>
        </button>
        <button style="background: transparent; border: none; color: var(--text-light); font-size: 14px; font-weight: 500; cursor: pointer; padding: 5px 0;">
            Drafts <span style="font-size: 12px; color: var(--text-light);">(2)</span>
        </button>
        <button style="background: transparent; border: none; color: var(--text-light); font-size: 14px; font-weight: 500; cursor: pointer; padding: 5px 0;">
            Scheduled <span style="font-size: 12px; color: var(--text-light);">(0)</span>
        </button>
    </div>

    <!-- Posts List -->
    <div class="posts-list-social">
        <!-- Post 1 -->
        <div class="post-social">
            <div class="post-header-social">
                <div class="post-author-social">
                    <div class="post-avatar-social">TC</div>
                    <div>
                        <h4>TechCorp Inc.</h4>
                        <div class="post-meta-social">
                            <span class="post-type-badge">Post</span>
                            <span class="post-type-badge pinned">Pinned</span>
                            <span class="post-time">2 hours ago</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="post-content-social">
                <p class="post-text-social">
                    We're thrilled to announce our Series B funding round! This milestone wouldn't be possible without our amazing team and supporters. Exciting times ahead as we scale our mission to revolutionize the industry.
                </p>
            </div>
            
            <div class="post-stats-social">
                <div class="stat-inline">
                    <span class="stat-number-inline">245</span>
                    <span>likes</span>
                </div>
                <div class="stat-inline">
                    <span class="stat-number-inline">42</span>
                    <span>comments</span>
                </div>
                <div class="stat-inline">
                    <span class="stat-number-inline">18</span>
                    <span>shares</span>
                </div>
                <div class="post-views">
                    <i class="bi bi-eye views-icon"></i>
                    <span>3,200 views</span>
                </div>
            </div>
            
            
        </div>

        <!-- Post 2 -->
        <div class="post-social post-announcement">
            <div class="post-header-social">
                <div class="post-author-social">
                    <div class="post-avatar-social">TC</div>
                    <div>
                        <h4>TechCorp Inc.</h4>
                        <div class="post-meta-social">
                            <span class="post-type-badge">Announcement</span>
                            <span style="color: var(--text-light);">🌔️ 👍</span>
                            <span class="post-time">4 hours ago</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="post-content-social">
                <p class="post-text-social">
                    Important Update: We're moving to a new office space! Starting January 2024, you can find us at 123 Innovation Drive. We can't wait to welcome you to our new home.
                </p>
            </div>
            
            <div class="post-stats-social">
                <div class="stat-inline">
                    <span class="stat-number-inline">189</span>
                    <span>likes</span>
                </div>
                <div class="stat-inline">
                    <span class="stat-number-inline">28</span>
                    <span>comments</span>
                </div>
                <div class="stat-inline">
                    <span class="stat-number-inline">12</span>
                    <span>shares</span>
                </div>
                <div class="post-views">
                    <i class="bi bi-eye views-icon"></i>
                    <span>2,100 views</span>
                </div>
            </div>
            
            <div class="post-actions-social">
                <button class="action-btn-social">Edit</button>
                <button class="action-btn-social">Insights</button>
                <button class="action-btn-social">More</button>
            </div>
        </div>
    </div>

  

    <!-- Floating Create Button -->
    <button style="position: fixed; bottom: 30px; right: 30px; width: 50px; height: 50px; background: var(--orange-gradient); color: white; border: none; border-radius: 50%; font-size: 20px; cursor: pointer; box-shadow: 0 4px 12px rgba(255, 122, 24, 0.3); transition: all 0.3s ease; display: flex; align-items: center; justify-content: center; z-index: 100;">
        <i class="bi bi-plus-lg"></i>
    </button>
</div>

<%- include('partials/footer') %>