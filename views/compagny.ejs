<%- include('partials/header') %>

<div class="company-dashboard">
    <div class="dashboard-content">
        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <div class="company-header">
                <h1 class="company-title">Company Dashboard</h1>
                <p class="company-subtitle">Overview of your company's performance and engagement</p>
            </div>

            <!-- Stats Grid (Removed Profile Views) -->
            <div class="stats-grid-compact">
                <!-- Total Followers -->
                <div class="stat-card-compact">
                    <div class="stat-label-compact">TOTAL FOLLOWERS</div>
                    <div class="stat-value-compact">2,890</div>
                    <div class="stat-change-compact positive">
                        <i class="bi bi-arrow-up"></i>
                        +12.5% from last month
                    </div>
                </div>

                <!-- Active Jobs -->
                <div class="stat-card-compact">
                    <div class="stat-label-compact">ACTIVE JOBS</div>
                    <div class="stat-value-compact">12</div>
                    <div class="stat-change-compact warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        3 expiring soon
                    </div>
                </div>

                <!-- Total Applications -->
                <div class="stat-card-compact">
                    <div class="stat-label-compact">TOTAL APPLICATIONS</div>
                    <div class="stat-value-compact">184</div>
                    <div class="stat-change-compact positive">
                        <i class="bi bi-arrow-up"></i>
                        +28% from last week
                    </div>
                </div>

                <!-- Company Engagement (Replaced Profile Views) -->
                <div class="stat-card-compact">
                    <div class="stat-label-compact">COMPANY ENGAGEMENT</div>
                    <div class="stat-value-compact">92%</div>
                    <div class="stat-change-compact positive">
                        <i class="bi bi-arrow-up"></i>
                        +8% this month
                    </div>
                </div>
            </div>

            <!-- Engagement Section -->
            <div class="engagement-section">
                <div class="engagement-header">
                    <h2 class="engagement-title">Engagement</h2>
                    <p class="engagement-subtitle">Followers - Job Performance</p>
                </div>
                <div class="engagement-content">
                    <!-- Weekly Chart -->
                    <div class="weekly-chart-container">
                        <div class="chart-header">
                            <h3 class="chart-title">Weekly Engagement</h3>
                            <p class="chart-subtitle">Posts, likes, and comments over the week</p>
                        </div>
                        <div class="chart-graph">
                            <div class="chart-y-axis">
                                <span>600</span>
                                <span>450</span>
                                <span>300</span>
                                <span>150</span>
                                <span>0</span>
                            </div>
                            <div class="chart-bars-horizontal">
                                <!-- Mon -->
                                <div class="chart-bar-vertical" style="height: 25%;"></div>
                                <!-- Tue -->
                                <div class="chart-bar-vertical" style="height: 40%; background: var(--accent-pink);"></div>
                                <!-- Wed -->
                                <div class="chart-bar-vertical" style="height: 65%;"></div>
                                <!-- Thu -->
                                <div class="chart-bar-vertical" style="height: 85%; background: var(--accent-pink);"></div>
                                <!-- Fri -->
                                <div class="chart-bar-vertical" style="height: 100%; background: var(--success);"></div>
                                <!-- Sat -->
                                <div class="chart-bar-vertical" style="height: 75%;"></div>
                                <!-- Sun -->
                                <div class="chart-bar-vertical" style="height: 50%; background: var(--accent-pink);"></div>
                            </div>
                            <div class="chart-labels-horizontal">
                                <span class="chart-label-day">Mon</span>
                                <span class="chart-label-day">Tue</span>
                                <span class="chart-label-day">Wed</span>
                                <span class="chart-label-day">Thu</span>
                                <span class="chart-label-day">Fri</span>
                                <span class="chart-label-day">Sat</span>
                                <span class="chart-label-day">Sun</span>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Stats -->
                    <div class="quick-stats-sidebar">
                        <h3 class="quick-stats-title">Quick Stats</h3>
                        <ul class="quick-stats-list">
                            <li class="quick-stats-item">
                                <span class="quick-stats-label">Total Likes</span>
                                <span class="quick-stats-value">2.2K</span>
                            </li>
                            <li class="quick-stats-item">
                                <span class="quick-stats-label">Comments</span>
                                <span class="quick-stats-value">421</span>
                            </li>
                            <li class="quick-stats-item">
                                <span class="quick-stats-label">Shares</span>
                                <span class="quick-stats-value">156</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Active Jobs Section -->
            <div class="active-jobs-section">
                <div class="active-jobs-header">
                    <h2 class="active-jobs-title">Active Jobs</h2>
                    <span class="active-jobs-badge">3 expiring soon</span>
                </div>
                
                <div class="job-list">
                    <div class="job-list-item expiring">
                        <div class="job-info">
                            <h5>Senior Frontend Developer</h5>
                            <p>Expires in 2 days • 45 applications</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="job-status expiring">Expiring</span>
                            <button class="btn btn-sm btn-outline-primary" onclick="openJobDetails('job1')">View Details</button>
                        </div>
                    </div>
                    
                    <div class="job-list-item">
                        <div class="job-info">
                            <h5>Product Manager</h5>
                            <p>Active • 32 applications</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="job-status active">Active</span>
                            <button class="btn btn-sm btn-outline-primary" onclick="openJobDetails('job2')">View Details</button>
                        </div>
                    </div>
                    
                    <div class="job-list-item expiring">
                        <div class="job-info">
                            <h5>UX Designer</h5>
                            <p>Expires in 5 days • 28 applications</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="job-status expiring">Expiring</span>
                            <button class="btn btn-sm btn-outline-primary" onclick="openJobDetails('job3')">View Details</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="dashboard-sidebar">
            <!-- Action Buttons (Updated: Removed Sign In, Added View Posts) -->
            <div class="sidebar-actions">
                <button class="sidebar-action-btn" onclick="showToast('Opening company posts')">
                    <i class="bi bi-eye me-2"></i>
                    View Posts
                </button>
                <button class="sidebar-action-btn secondary" onclick="showToast('Opening job management')">
                    <i class="bi bi-briefcase me-2"></i>
                    Manage Jobs
                </button>
            </div>
           
            <!-- Recent Applicants (Optional Section) -->
            <div class="recent-applicants mt-4">
                <h6 class="sidebar-title mb-3">Recent Applicants</h6>
                <div class="applicant-item mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <div class="applicant-avatar">SC</div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold">Sarah Chen</h6>
                            <p class="text-secondary small mb-0">Applied for Senior Frontend Developer</p>
                        </div>
                    </div>
                    <span class="applicant-time small text-secondary">2 hours ago</span>
                </div>
                <div class="applicant-item">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <div class="applicant-avatar">MW</div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-bold">Marcus Williams</h6>
                            <p class="text-secondary small mb-0">Applied for Product Manager</p>
                        </div>
                    </div>
                    <span class="applicant-time small text-secondary">1 day ago</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Job Details Modal (Copied exactly from jobs page) -->
<div class="edit-form-overlay" id="jobDetailsModal">
    <div class="edit-form-container" style="max-width: 800px;">
        <div class="edit-form-header">
            <h3 class="edit-form-title" id="jobDetailsTitle">Senior Frontend Developer</h3>
            <button class="close-form-btn" onclick="closeJobDetails()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div id="jobDetailsContent" class="p-3">
            <!-- Dynamic content will be inserted here -->
        </div>
        <div class="form-actions">
            <button type="button" class="btn-save" onclick="showToast('Viewing applications for this job')">View Applications</button>
            <button type="button" class="btn-cancel" onclick="closeJobDetails()">Close</button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

