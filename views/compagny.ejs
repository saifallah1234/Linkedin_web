<script>
let currentJobId = null;
let currentJobTitle = null;

// Job Details Functions
function openJobDetails(jobId) {
    currentJobId = jobId;
    const modal = document.getElementById('jobDetailsModal');
    const title = document.getElementById('jobDetailsTitle');
    const content = document.getElementById('jobDetailsContent');
    
    // Set job title based on ID
    if (jobId === 'job1') {
        currentJobTitle = 'Senior Frontend Developer';
        title.textContent = 'Senior Frontend Developer';
        content.innerHTML = getJob1Details();
    } else if (jobId === 'job2') {
        currentJobTitle = 'Product Manager';
        title.textContent = 'Product Manager';
        content.innerHTML = getJob2Details();
    } else if (jobId === 'job3') {
        currentJobTitle = 'UX Designer';
        title.textContent = 'UX Designer';
        content.innerHTML = getJob3Details();
    }
    
    modal.classList.add('active');
}

function closeJobDetails() {
    document.getElementById('jobDetailsModal').classList.remove('active');
}

// Job 1 Details (Senior Frontend Developer)
function getJob1Details() {
    return `
        <div class="job-detail-section">
            <h6 class="detail-title">About the Role</h6>
            <p class="detail-content">
                We're looking for a Senior Frontend Developer to join our engineering team. 
                You'll be responsible for building and maintaining our web applications using modern technologies.
            </p>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Responsibilities</h6>
            <ul class="requirements-list">
                <li>Develop and maintain responsive web applications</li>
                <li>Collaborate with designers to implement pixel-perfect UI</li>
                <li>Write clean, maintainable, and well-documented code</li>
                <li>Optimize applications for maximum performance</li>
                <li>Participate in code reviews and mentor junior developers</li>
                <li>Stay up-to-date with emerging technologies</li>
            </ul>
        </div>
        
        <div class="job-detail-section">
            <h6 class="detail-title">Requirements</h6>
            <ul class="requirements-list">
                <li>5+ years of frontend development experience</li>
                <li>Expertise in React.js and TypeScript</li>
