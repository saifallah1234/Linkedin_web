        document.getElementById('aiPostToggle').checked = false;
        document.getElementById('includeHashtags').checked = false;
        document.getElementById('postSubmitBtn').disabled = true;
        this.mediaFiles = [];
        this.updateMediaPreview();
    }

    // Utility functions
    getTimeAgo(date) {
        if (!date || isNaN(new Date(date).getTime())) return 'Just now';
        
        const now = new Date();
        const diff = now - new Date(date);
        
        const minute = 60 * 1000;
        const hour = minute * 60;
        const day = hour * 24;
        const week = day * 7;
        const month = day * 30;
        const year = day * 365;
        
        if (diff < minute) return 'Just now';
        if (diff < hour) return Math.floor(diff / minute) + 'm ago';
        if (diff < day) return Math.floor(diff / hour) + 'h ago';
        if (diff < week) return Math.floor(diff / day) + 'd ago';
        if (diff < month) return Math.floor(diff / week) + 'w ago';
        if (diff < year) return Math.floor(diff / month) + 'mo ago';
        return Math.floor(diff / year) + 'y ago';
    }

    escapeHTML(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Notification functions
    showSuccess(message) {
        this.showNotification(message, 'success');
    }

    showError(message) {
        this.showNotification(message, 'error');
    }

    showNotification(message, type = 'info') {
        // Remove existing toasts
        document.querySelectorAll('.reaction-toast').forEach(toast => toast.remove());
        
        const toast = document.createElement('div');
        toast.className = `reaction-toast ${type}`;
        toast.innerHTML = `
            <div class="toast-content">
                <i class="bi ${type === 'success' ? 'bi-check-circle text-success' : 'bi-exclamation-circle text-danger'} me-2"></i>
                <span>${message}</span>
            </div>
        `;
        
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.style.animation = 'fadeOut 0.3s ease-out';
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 300);
        }, 3000);
    }

    showReactionToast(reactionType) {
        const emoji = this.reactionEmojis[reactionType] || '👍';
        const label = this.reactionLabels[reactionType] || 'Reaction';
        
        // Remove existing toasts
        document.querySelectorAll('.reaction-toast').forEach(toast => toast.remove());
        
        const toast = document.createElement('div');
        toast.className = 'reaction-toast';
        toast.innerHTML = `
            <div class="toast-content">
                <span class="reaction-emoji">${emoji}</span>
                <span>${label} added!</span>
            </div>
        `;
        
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.style.animation = 'fadeOut 0.3s ease-out';
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 300);
        }, 2000);
    }

    // Initialize everything
    async initialize() {
        if (!this.token) {
            window.location.href = '/auth/login';
            return;
        }
        
        try {
            // Load all data
            await this.loadUserProfile();
            await this.loadTrendingTopics();
            await this.loadFeedPosts();
            await this.loadPeopleSuggestions();
            await this.loadJobInsights();
            
            // Setup event listeners
            this.setupEventListeners();
            this.setupMediaUpload();
            
            console.log('Feed Manager initialized successfully');
        } catch (error) {
            console.error('Error initializing feed manager:', error);
            this.showError('Failed to initialize feed. Please refresh the page.');
        }
    }

    setupEventListeners() {
        // AI toggle
        document.getElementById('aiPostToggle').addEventListener('change', (e) => {
            const aiEnhanceBtn = document.getElementById('aiEnhanceBtn');
            const aiModeStatus = document.getElementById('aiModeStatus');
            
            if (e.target.checked) {
                aiEnhanceBtn.style.display = 'flex';
                aiModeStatus.textContent = '(On)';
                aiModeStatus.className = 'ai-mode-status text-success small';
            } else {
                aiEnhanceBtn.style.display = 'none';
                aiModeStatus.textContent = '(Off)';
                aiModeStatus.className = 'ai-mode-status text-secondary small';
            }
        });
        
        // Post input
        document.getElementById('postInput').addEventListener('input', (e) => {
            document.getElementById('postSubmitBtn').disabled = !e.target.value.trim();
        });
        
        // Post submit
        document.getElementById('postSubmitBtn').addEventListener('click', () => this.createPost());
        
        // AI enhance button
        document.getElementById('aiEnhanceBtn').addEventListener('click', async () => {
            const postInput = document.getElementById('postInput');
            const content = postInput.value.trim();
            
            if (!content) {
                this.showError('Please type something first before enhancing with AI!');
                return;
            }
            
            // Simulate AI enhancement
            postInput.value = content + " 🤖 [Enhanced by AI for better engagement!]";
            
            const btn = document.getElementById('aiEnhanceBtn');
            btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Enhanced';
            btn.style.background = 'var(--success-light)';
            btn.style.color = 'var(--success)';
            
            setTimeout(() => {
                btn.innerHTML = '<i class="bi bi-magic me-1"></i> Enhance with AI';
                btn.style.background = '';
                btn.style.color = '';
            }, 2000);
        });
        
        // Modal save buttons
        document.getElementById('saveEditPostBtn').addEventListener('click', () => this.saveEditedPost());
        document.getElementById('submitCommentBtn').addEventListener('click', () => this.addComment());
        document.getElementById('saveEditCommentBtn').addEventListener('click', () => this.saveEditedComment());
        document.getElementById('submitReplyBtn').addEventListener('click', () => this.submitReply());
        
        // Enter key for post input
        document.getElementById('postInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                if (!document.getElementById('postSubmitBtn').disabled) {
                    this.createPost();
                }
            }
        });
        
        // Enter key for comment inputs
        document.addEventListener('keydown', (e) => {
            if (e.target.matches('textarea[id^="comment-input-"]') && e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                const postId = e.target.id.replace('comment-input-', '');
                if (e.target.value.trim()) {
                    this.addComment(postId);
                }
            }
        });
        
        // Hide reaction pickers when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.reaction-trigger-btn') && !e.target.closest('.reaction-picker')) {
                document.querySelectorAll('.reaction-picker').forEach(p => {
                    p.classList.add('d-none');
                    p.classList.remove('active');
                });
            }
        });
        
        // Handle reaction picker hover
        document.addEventListener('mouseover', (e) => {
            if (e.target.closest('.reaction-picker')) {
                // Keep picker open when hovering over it
                const picker = e.target.closest('.reaction-picker');
                picker.classList.add('active');
            }
        });
    }
}

// Initialize Feed Manager
const feedManager = new FeedManager();

// Protect route and initialize
document.addEventListener('DOMContentLoaded', async () => {
    // Check authentication
    const token = localStorage.getItem('token');
    if (!token) {
        window.location.href = '/auth/login';
        return;
    }
    
    // Initialize feed manager
    await feedManager.initialize();
});
</script>

