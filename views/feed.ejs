<style>
/* AI Post Toggle Styles */
.ai-post-toggle-container {
    background: white;
    padding: 15px 20px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    border: 1px solid var(--border-color);
}

.ai-toggle-switch .form-check-input {
    width: 48px;
    height: 24px;
    cursor: pointer;
}

.ai-toggle-switch .form-check-input:checked {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.ai-toggle-switch .form-check-label {
    cursor: pointer;
    color: var(--text-dark);
    font-weight: 600;
}

.ai-toggle-description {
    font-size: 0.85rem;
    max-width: 500px;
}

/* Reaction Styles */
.post-reactions {
    display: flex;
    align-items: center;
}

.reaction-icons {
    display: flex;
    align-items: center;
    gap: 4px;
}

.reaction-icon {
    font-size: 16px;
    background: white;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: all 0.2s ease;
}

.reaction-icon:hover {
    transform: scale(1.2);
}

.reaction-count {
    font-size: 0.875rem;
    color: var(--text-dark);
    font-weight: 500;
    margin-left: 4px;
}

/* Reaction Picker */
.reaction-picker {
    position: absolute;
    bottom: 100%;
    left: 0;
    display: none;
    z-index: 100;
}

.reaction-picker.active {
    display: block;
}

.reaction-options {
    border: 1px solid var(--border-color);
    animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.reaction-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    transition: all 0.2s ease;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.reaction-btn:hover {
    background: var(--light-bg);
    transform: scale(1.2);
}

/* Post Action Button with Reaction */
.post-action-btn.reaction-trigger-btn {
    position: relative;
}

.post-action-btn.reaction-trigger-btn.active {
    color: var(--primary-color);
}

.post-action-btn.reaction-trigger-btn.active i {
    color: var(--primary-color);
}

/* Enhance with AI Button */
#aiEnhanceBtn {
    position: relative;
}

#aiEnhanceBtn:hover {
    background: var(--primary-light);
    color: var(--primary-color);
}

/* Reaction animation */
@keyframes bounce {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
}

.reaction-added {
    animation: bounce 0.3s ease;
}

/* Custom reaction colors */
.reaction-btn[data-reaction="like"]:hover { background: rgba(59, 130, 246, 0.1); }
.reaction-btn[data-reaction="love"]:hover { background: rgba(239, 68, 68, 0.1); }
.reaction-btn[data-reaction="dislike"]:hover { background: rgba(107, 114, 128, 0.1); }
.reaction-btn[data-reaction="encourage"]:hover { background: rgba(16, 185, 129, 0.1); }
.reaction-btn[data-reaction="haha"]:hover { background: rgba(245, 158, 11, 0.1); }
</style>

<script>
// Interactive JavaScript for the dashboard
document.addEventListener('DOMContentLoaded', function() {
    // AI Post Toggle
    const aiPostToggle = document.getElementById('aiPostToggle');
    const aiModeStatus = document.getElementById('aiModeStatus');
    const aiEnhanceBtn = document.getElementById('aiEnhanceBtn');
    const postInput = document.getElementById('postInput');
    
    aiPostToggle.addEventListener('change', function() {
        if (this.checked) {
            aiModeStatus.textContent = '(On)';
            aiModeStatus.className = 'ai-mode-status text-success small';
            aiEnhanceBtn.style.display = 'flex';
        } else {
            aiModeStatus.textContent = '(Off)';
            aiModeStatus.className = 'ai-mode-status text-secondary small';
            aiEnhanceBtn.style.display = 'none';
        }
    });

    // AI Enhance Button
    aiEnhanceBtn.addEventListener('click', function() {
        const currentText = postInput.value.trim();
        if (currentText) {
            // Simulate AI enhancement
            postInput.value = currentText + " 🤖 [Enhanced by AI: This post has been optimized for better engagement!]";
            this.innerHTML = '<i class="bi bi-check-circle me-1"></i> Enhanced';
            this.style.background = 'var(--success-light)';
            this.style.color = 'var(--success)';
            
            setTimeout(() => {
                this.innerHTML = '<i class="bi bi-magic me-1"></i> Enhance with AI';
                this.style.background = '';
                this.style.color = '';
            }, 2000);
        } else {
            alert('Please type something first before enhancing with AI!');
        }
    });

    // Reaction functionality
    const reactionTriggerBtns = document.querySelectorAll('.reaction-trigger-btn');
    const reactionPickers = document.querySelectorAll('.reaction-picker');
    
    reactionTriggerBtns.forEach((btn, index) => {
        const reactionPicker = reactionPickers[index];
        let reactionPickerVisible = false;
        
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            
            // Close other pickers
            reactionPickers.forEach(picker => {
                if (picker !== reactionPicker) {
                    picker.classList.remove('active');
                }
            });
            
            // Toggle current picker
            reactionPickerVisible = !reactionPickerVisible;
            reactionPicker.classList.toggle('active', reactionPickerVisible);
            
            // Update button state
            this.classList.toggle('active', reactionPickerVisible);
        });
        
        // Reaction buttons inside picker
        const reactionBtns = reactionPicker.querySelectorAll('.reaction-btn');
        reactionBtns.forEach(reactionBtn => {
            reactionBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                const reaction = this.getAttribute('data-reaction');
                const postId = btn.getAttribute('data-post-id');
                addReaction(postId, reaction, btn, reactionPicker);
            });
        });
    });
    
    // Close reaction pickers when clicking outside
    document.addEventListener('click', function() {
        reactionPickers.forEach(picker => {
            picker.classList.remove('active');
        });
        reactionTriggerBtns.forEach(btn => {
            btn.classList.remove('active');
        });
    });

    // Function to add reaction
    function addReaction(postId, reaction, button, picker) {
        // Close the picker
        picker.classList.remove('active');
        button.classList.remove('active');
        
        // Get post stats
        const post = button.closest('.feed-post');
        const reactionIcons = post.querySelector('.reaction-icons');
        const reactionCount = post.querySelector('.reaction-count');
        
        // Remove any existing user reaction
        const existingUserReaction = reactionIcons.querySelector('.user-reaction');
        if (existingUserReaction) {
            existingUserReaction.remove();
        }
        
        // Add new reaction
        const reactionEmoji = getReactionEmoji(reaction);
        const userReaction = document.createElement('span');
        userReaction.className = 'reaction-icon user-reaction reaction-added';
        userReaction.setAttribute('data-reaction', reaction);
        userReaction.textContent = reactionEmoji;
        userReaction.title = getReactionTitle(reaction);
        
        // Insert before count
        reactionIcons.insertBefore(userReaction, reactionCount);
        
        // Update button text and icon
        button.innerHTML = `<span>${getReactionTitle(reaction)}</span>`;
        button.style.color = 'var(--primary-color)';
        
        // Update reaction count
        let currentCount = parseInt(reactionCount.textContent);
        if (!isNaN(currentCount)) {
            // Only increment if this is a new reaction (not changing existing)
            if (!existingUserReaction) {
                reactionCount.textContent = currentCount + 1;
            }
        }
        
        // Show confirmation
        showReactionToast(reaction);
    }

    // Helper functions for reactions
    function getReactionEmoji(reaction) {
        const emojis = {
            'like': '👍',
            'love': '❤️',
            'dislike': '👎',
            'encourage': '💪',
            'haha': '😂'
        };
        return emojis[reaction] || '👍';
    }

    function getReactionTitle(reaction) {
        const titles = {
            'like': 'Like',
            'love': 'Love',
            'dislike': 'Dislike',
            'encourage': 'Encourage',
            'haha': 'Haha'
        };
        return titles[reaction] || 'Like';
    }

    function showReactionToast(reaction) {
        // Create toast element
        const toast = document.createElement('div');
        toast.className = 'reaction-toast';
        toast.innerHTML = `
            <div class="toast-content">
                <span class="reaction-emoji">${getReactionEmoji(reaction)}</span>
                <span>${getReactionTitle(reaction)} reaction added!</span>
            </div>
        `;
        
        // Style toast
        toast.style.position = 'fixed';
        toast.style.bottom = '20px';
        toast.style.right = '20px';
        toast.style.background = 'white';
        toast.style.padding = '12px 16px';
        toast.style.borderRadius = '8px';
        toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
        toast.style.zIndex = '10000';
        toast.style.animation = 'fadeIn 0.3s ease-out';
        toast.style.display = 'flex';
        toast.style.alignItems = 'center';
        toast.style.gap = '8px';
        toast.style.fontWeight = '500';
        
        document.body.appendChild(toast);
        
        // Remove toast after 2 seconds
        setTimeout(() => {
            toast.style.animation = 'fadeOut 0.3s ease-out';
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 300);
        }, 2000);
    }

    // Connect button functionality
    const connectButtons = document.querySelectorAll('.connect-btn');
    connectButtons.forEach(button => {
        button.addEventListener('click', function() {
            const originalText = this.textContent;
            if (originalText === 'Connect') {
                this.textContent = 'Pending';
                this.style.background = 'var(--primary-light)';
                this.style.color = 'var(--primary-color)';
                this.style.border = '1px solid var(--primary-color)';
                
                // After 2 seconds, change to "Connected"
                setTimeout(() => {
                    this.textContent = 'Connected';
                    this.style.background = 'var(--success)';
                    this.style.color = 'white';
                    this.style.border = 'none';
                    this.disabled = true;
                }, 2000);
            }
        });
    });

    // Post submission
    const postSubmitBtn = document.getElementById('postSubmitBtn');
    
    postInput.addEventListener('input', function() {
        postSubmitBtn.disabled = this.value.trim().length === 0;
    });
    
    postSubmitBtn.addEventListener('click', function() {
        const postText = postInput.value.trim();
        if (postText) {
            // Check if AI mode is on
            const aiMode = aiPostToggle.checked;
            const enhancedText = aiMode ? postText + " 🤖 [AI Enhanced]" : postText;
            
            alert('Post created: ' + enhancedText);
            postInput.value = '';
            this.disabled = true;
        }
    });

    // Hover effects for cards
    const cards = document.querySelectorAll('.card-nexus');
    cards.forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-2px)';
            this.style.boxShadow = '0 8px 30px rgba(255, 122, 24, 0.12)';
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
            this.style.boxShadow = '';
        });
    });

    // People items hover
    const peopleItems = document.querySelectorAll('.people-item');
    peopleItems.forEach(item => {
        item.addEventListener('mouseenter', function() {
            this.style.background = 'var(--primary-light)';
            this.style.borderRadius = '8px';
            this.style.padding = '12px';
            this.style.margin = '-12px -12px';
        });
        
        item.addEventListener('mouseleave', function() {
            this.style.background = '';
            this.style.padding = '';
            this.style.margin = '';
        });
    });

    // Trending items hover
    const trendingItems = document.querySelectorAll('.trending-item');
    trendingItems.forEach(item => {
        item.addEventListener('mouseenter', function() {
            this.style.background = 'var(--primary-light)';
        });
        
        item.addEventListener('mouseleave', function() {
            this.style.background = '';
        });
    });

    // Add fade out animation
    const style = document.createElement('style');
    style.textContent = `
        @keyframes fadeOut {
            from {
                opacity: 1;
                transform: translateY(0);
            }
            to {
                opacity: 0;
                transform: translateY(10px);
            }
        }
    `;
    document.head.appendChild(style);
});
</script>