    // Create a new post
    async createPost() {
        const content = document.getElementById('postInput').value.trim();
        const useAI = document.getElementById('aiPostToggle').checked;
        const includeHashtags = document.getElementById('includeHashtags').checked;
        
        if (!content) {
            this.showError('Please enter some content for your post');
            return;
        }
        
        let finalContent = content;
        
        // Add trending hashtags if enabled
        if (includeHashtags) {
            const trendingTags = await this.getTrendingHashtags();
            if (trendingTags) {
                finalContent += '\n\n' + trendingTags;
            }
        }
        
        const formData = new FormData();
        formData.append('content', finalContent);
        formData.append('useAI', useAI);
        
        // Add media files
        this.mediaFiles.forEach((file, index) => {
            formData.append('media', file);
        });
        
        try {
            const response = await this.authFetch('/api/posts', {
                method: 'POST',
                body: formData
            });
            
            if (response.ok) {
                const data = response.status !== 304 ? await response.json() : {};
                this.showSuccess('Post created successfully!');
                this.resetPostForm();
                this.loadFeedPosts(); // Reload feed
            } else {
                const error = await response.json();
                throw new Error(error.message || 'Failed to create post');
            }
        } catch (error) {
            console.error('Error creating post:', error);
            this.showError(error.message || 'Failed to create post. Please try again.');
        }
    }

    // Get trending hashtags
    async getTrendingHashtags() {
        try {
            const response = await fetch('/api/trends/topics?limit=3');
            if (response.ok) {
                const data = await response.json();
                const topics = data.data || [];
                return topics.map(topic => topic.tag).join(' ');
            }
        } catch (error) {
            console.error('Error getting trending hashtags:', error);
        }
        return null;
    }

