    // Add comment
    async addComment(postId) {
        let targetPostId = postId || this.currentPostId;
        let contentEl = document.getElementById(`comment-input-${targetPostId}`);
        let aiEl = document.getElementById(`comment-ai-${targetPostId}`);

        const content = contentEl ? contentEl.value.trim() : '';
        const useAI = aiEl ? aiEl.checked : false;

        if (!content) {
            this.showError('Please enter a comment');
            return;
        }

        try {
            const response = await this.authFetch(`/api/posts/${targetPostId}/comments`, {
                method: 'POST',
                body: JSON.stringify({ content, useAI })
            });

            if (response.ok) {
                const data = response.status !== 304 ? await response.json() : {};
                
                // Clear input
                if (contentEl) contentEl.value = '';
                if (aiEl) aiEl.checked = false;

                // Reload comments
                await this.loadCommentsForPost(targetPostId);
                
                // Update comment count
                const postElement = document.querySelector(`[data-post-id="${targetPostId}"]`);
                if (postElement) {
                    const commentCountEl = postElement.querySelector('.fw-medium[onclick*="toggleComments"]');
                    if (commentCountEl) {
