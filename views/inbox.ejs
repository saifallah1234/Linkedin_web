<div class="card shadow-sm border-0 message-container" style="height: 80vh;">
    <div class="row g-0 h-100">
        <div class="col-md-4 border-end overflow-auto h-100">
            <div class="p-3 bg-white border-bottom sticky-top">
                <h6 class="fw-bold mb-0">Messaging</h6>
            </div>
            <div id="conversation-list" class="list-group list-group-flush">
                </div>
        </div>

        <div class="col-md-8 d-flex flex-column h-100">
            <div id="chat-header" class="p-3 border-bottom d-none">
                <h6 class="fw-bold mb-0" id="active-user-name">Select a conversation</h6>
            </div>
            <div id="chat-messages" class="flex-grow-1 p-3 overflow-auto bg-light d-flex flex-column">
                <div class="my-auto text-center text-muted">
                    <i class="bi bi-chat-square-text fs-1 d-block mb-2"></i>
                    <p>Start a new conversation</p>
                </div>
            </div>
            <form id="send-msg-form" class="p-3 border-top bg-white d-none">
                <div class="input-group">
                    <input type="text" id="msg-input" class="form-control" placeholder="Write a message...">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-send-fill"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>