<%- include('../partials/header', { hideNavbar: true, hideFooter: true, title: 'Sign In - Nexus' }) %>

<div class="auth-page">
    <!-- Left Column -->
    <div class="auth-left">
        <div class="mb-5">
            <h1 class="display-4 fw-bold mb-4">Your professional network, reimagined.</h1>
            <p class="fs-5 mb-0">Connect with opportunities, build meaningful relationships, and grow your career with AI-powered insights.</p>
        </div>
        <div class="mt-auto">
            <h4 class="mb-3">Join 50,000+ professionals</h4>
        </div>
    </div>

    <!-- Right Column -->
    <div class="auth-right">
        <div class="auth-form">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Welcome back</h2>
                <p class="text-secondary">Enter your credentials to access your account</p>
            </div>

            <form action="/auth/login" method="POST">
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" 
                           class="form-input" 
                           placeholder="name@example.com"
                           required>
                </div>

                <div class="form-group">
                    <label class="form-label">Password</label>
                    <input type="password" 
                           class="form-input" 
                           required>
                    <div class="text-end mt-2">
                        <a href="/forgot-password" class="text-primary text-decoration-none small">Forgot password?</a>
                    </div>
                </div>

                <button type="submit" class="btn-primary mb-3">Sign In</button>
            </form>

            <div class="divider">
                <span class="divider-text">OR CONTINUE WITH</span>
            </div>

            <div class="social-buttons mb-4">
                <button class="social-btn">
                    <i class="bi bi-google"></i>
                    Google
                </button>
                <button class="social-btn">
                    <i class="bi bi-github"></i>
                    GitHub
                </button>
            </div>

            <div class="text-center">
                <p class="text-secondary">Don't have an account? <a href="/auth/register" class="text-primary text-decoration-none">Sign Up</a></p>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer', { hideNavbar: true, hideFooter: true }) %>